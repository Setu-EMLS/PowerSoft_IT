<main class="col-md-10 px-4 admin">
    <div class="header mt-4 bt-5">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3>Manage User</h3>
            </div>
        </div>
    </div><br /><br />

    <table id="myTable" class="display table table-striped">
        <thead>
            <tr>
                <th>SL</th>
                <th>User Name</th>
                <th>Age</th>
                <th>Full Name</th>
                <th>Appointment Date</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>Rahim</td>
