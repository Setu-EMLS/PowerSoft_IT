@model List<User>
@{
    ViewData["Title"] = "Admin Users";
    var me = User.GetUserId();
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card-lms">
            <div class="card-lms-header"><h5>Administrators</h5></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Name</th><th>Email</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@u.FullName @if (u.UserId == me) { <span class="badge bg-light text-dark border">You</span> }</td>
                                <td>@u.Email</td>
                                <td>@if (u.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-danger">Inactive</span> }</td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#pw-@u.UserId"><i class="fa-solid fa-key"></i></button>
                                    @if (u.UserId != me)
                                    {
                                        <form asp-action="ToggleActive" asp-route-id="@u.UserId" method="post" class="inline-form">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fa-solid @(u.IsActive ? "fa-user-lock" : "fa-user-check")"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                            <tr class="collapse" id="pw-@u.UserId">
                                <td colspan="4">
                                    <form asp-action="ResetPassword" asp-route-id="@u.UserId" method="post" class="d-flex gap-2">
                                        <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="New password (min 6 characters)" minlength="6" required autocomplete="new-password" />
                                        <button type="submit" class="btn btn-sm btn-brand text-nowrap">Set password</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-lms">
            <div class="card-lms-header"><h5><i class="fa-solid fa-user-shield me-2 text-brand"></i>Add administrator</h5></div>
            <div class="card-lms-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3"><label class="form-label" for="Name">Full name</label><input class="form-control" id="Name" name="Name" required /></div>
                    <div class="mb-3"><label class="form-label" for="Email">Email</label><input class="form-control" id="Email" name="Email" type="email" required /></div>
                    <div class="mb-3"><label class="form-label" for="Contact">Mobile</label><input class="form-control" id="Contact" name="Contact" /></div>
                    <div class="mb-3"><label class="form-label" for="Password">Password</label><input class="form-control" id="Password" name="Password" type="password" minlength="6" required autocomplete="new-password" /></div>
                    <button type="submit" class="btn btn-brand w-100">Create admin</button>
                </form>
            </div>
        </div>
    </div>
</div>
