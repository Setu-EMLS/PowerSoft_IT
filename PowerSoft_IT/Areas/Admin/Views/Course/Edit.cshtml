@model Course
@{
    ViewData["Title"] = "Edit Course";
}
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_CourseForm" model="Model" />
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-brand px-4">Save changes</button>
        <a href="/Teacher/Curriculum/Index/@Model.Id" class="btn btn-outline-brand"><i class="fa-solid fa-list-ol me-1"></i> Manage content</a>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
