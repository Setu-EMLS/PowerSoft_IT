<main class="col-md-10 px-4 admin">
    <div class="header mt-4 bt-5">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3>Manage Course</h3>
            </div>
        </div>
    </div><br /><br />

    <table id="courseTable" class="display table table-striped">
        <thead>
            <tr>
                <th>SL</th>
                <th>Title</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th>Action</th>
            </tr>
        </thead>
    </table>


</main>

<!-- Modal (Add/Edit) -->
<div class="modal fade" id="addCourseModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="courseTitle" placeholder="Course Title" class="form-control mb-2" />
                <textarea id="courseDesc" placeholder="Description" class="form-control mb-2"></textarea>
                <input type="number" id="coursePrice" placeholder="Price" class="form-control mb-2" />
                <select id="courseCategory" class="form-control mb-2">
                    <option value="1">Software</option>
                    <option value="2">Website</option>
                    <option value="3">Database</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" id="saveCourseBtn" class="btn btn-success">Save</button>
            </div>
        </div>
    </div>
</div>


<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

<!-- DataTables Buttons CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

<!-- DataTables Buttons JS -->
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
        $(document).ready(function () {
    var table = $('#courseTable').DataTable({
        ajax: {
            url: '/Course/GetAll',
            type: 'GET',
            dataType: 'json',
            dataSrc: 'data'
        },
        columns: [
            {
                data: null,
                render: (data, type, row, meta) => meta.row + 1 // SL No
            },
            { data: 'title' },
            { data: 'coursecategory.name' }, // match C# property name
            { data: 'price' },
            {
                data: 'id',
                render: function (data) {
                    return `
                        <button class="btn btn-sm btn-primary editBtn" data-id="${data}">Edit</button>
                        <button class="btn btn-sm btn-danger deleteBtn" data-id="${data}">Delete</button>
                    `;
                }
            }
        ],
        paging: true,
        searching: true,
        ordering: true,
        info: true,
        responsive: true,
        dom: 'Bfrtip',
        buttons: [
            {
                text: '+ Add Course',
                className: 'btn addBtn',
                action: function () {
                    $('#addCourseModal').modal('show');
                }
            }
        ],
        initComplete: function () {
            $('#courseTable thead th').css({
                'background-color': '#4B92CD',
                'color': 'white',
                'text-align': 'center'
            });

            $('#courseTable td').css({
                'text-align': 'center'
            });
        }
    });

        // ✅ Create
        $('#saveCourseBtn').click(function () {
            var course = {
                title: $('#courseTitle').val(),
                description: $('#courseDesc').val(),
                price: $('#coursePrice').val(),
                categoryId: $('#courseCategory').val()
            };

            $.ajax({
                url: '/Course/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(course),
                success: function (res) {
                    if (res.success) {
                        $('#addCourseModal').modal('hide');
                        table.ajax.reload();
                        alert(res.message);
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        // ✅ Delete
        $(document).on('click', '.deleteBtn', function () {
            var id = $(this).data('id');
            if (confirm("Are you sure you want to delete this course?")) {
                $.post('/Course/Delete', { id: id }, function (res) {
                    if (res.success) {
                        table.ajax.reload();
                        alert(res.message);
                    } else {
                        alert(res.message);
                    }
                });
            }
        });
    });


</script>
