@model PersonFormViewModel
@{
    ViewData["Title"] = "Add Teacher";
    ViewData["ShowDesignation"] = true;
}
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <partial name="_PersonForm" model="Model" view-data="ViewData" />
    <button type="submit" class="btn btn-brand px-4">Create teacher</button>
    <a asp-action="Index" class="btn btn-light">Cancel</a>
</form>
