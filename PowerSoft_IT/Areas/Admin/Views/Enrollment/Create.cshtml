@{
    ViewData["Title"] = "Enroll a Student";
    var prices = (Dictionary<int, decimal>)ViewBag.CoursePrices;
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-lms">
            <div class="card-lms-header"><h5>Manual enrollment</h5></div>
            <div class="card-lms-body">
                <p class="text-muted">Use this for payments received at the office. The student gets access immediately.</p>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label" for="studentId">Student</label>
                        <select class="form-select" id="studentId" name="studentId" asp-items="ViewBag.Students" required>
                            <option value="">— Select student —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="courseId">Course</label>
                        <select class="form-select" id="courseId" name="courseId" asp-items="ViewBag.Courses" required>
                            <option value="">— Select course —</option>
                        </select>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label" for="amount">Amount paid (BDT)</label>
                            <input class="form-control" id="amount" name="amount" type="number" min="0" step="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="paymentMethod">Method</label>
                            <input class="form-control" id="paymentMethod" name="paymentMethod" placeholder="Cash (office)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="transactionId">Receipt / TrxID</label>
                            <input class="form-control" id="transactionId" name="transactionId" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-brand px-4">Enroll student</button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var prices = @Json.Serialize(prices);
        var courseSelect = document.getElementById('courseId');
        function fillPrice() {
            var p = prices[courseSelect.value];
            if (p !== undefined) document.getElementById('amount').value = p;
        }
        courseSelect.addEventListener('change', fillPrice);
        fillPrice();
    </script>
}
