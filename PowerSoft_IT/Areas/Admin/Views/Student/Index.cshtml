@model List<StudentEntity>
@{
    ViewData["Title"] = "Students";
}
<div class="page-head">
    <div>
        <h2>Students</h2>
        <p>Students can register themselves from the website, or you can add them here.</p>
    </div>
    <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-user-plus me-1"></i> Add student</a>
</div>

<div class="card-lms">
    <div class="card-lms-body">
        <div class="table-responsive">
            <table class="table datatable">
                <thead>
                    <tr><th>Student</th><th>ID</th><th>Contact</th><th>Courses</th><th>Joined</th><th>Status</th><th class="no-sort text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var active = s.User?.IsActive ?? false;
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@s.Id" class="d-flex align-items-center gap-2 text-decoration-none text-reset">
                                    <img src="@UiHelpers.Avatar(s.PhotoPath)" class="avatar-sm" alt="" />
                                    <span class="fw-semibold">@s.Name</span>
                                </a>
                            </td>
                            <td><code>@s.StudentID</code></td>
                            <td><div>@s.Email</div><small class="text-muted">@s.Contact</small></td>
                            <td>
                                @s.Enrollments.Count(e => e.HasAccess)
                                @{ var pending = s.Enrollments.Count(e => e.Status == EnrollmentStatus.Pending); }
                                @if (pending > 0) { <span class="badge bg-warning text-dark">@pending pending</span> }
                            </td>
                            <td class="text-nowrap" data-order="@(s.User?.CreatedAt.Ticks ?? 0)">@(s.User?.CreatedAt.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>
                                @if (s.User == null) { <span class="badge bg-secondary">No login</span> }
                                else if (active) { <span class="badge bg-success">Active</span> }
                                else { <span class="badge bg-danger">Inactive</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-brand" title="View"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                @if (s.User != null)
                                {
                                    <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="inline-form">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(active ? "Deactivate" : "Activate")">
                                            <i class="fa-solid @(active ? "fa-user-lock" : "fa-user-check")"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="inline-form" data-confirm="Delete student '@s.Name' and their login?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
