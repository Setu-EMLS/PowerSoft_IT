@using EduLearn.Services.Interfaces
@model StudentEntity
@{
    ViewData["Title"] = Model.Name;
    var progress = (Dictionary<int, CourseProgress>)ViewBag.Progress;
    var submissions = (List<AssignmentSubmission>)ViewBag.Submissions;
    var attempts = (List<QuizAttempt>)ViewBag.Attempts;
}
<div class="row g-3">
    <div class="col-xl-4">
        <div class="card-lms mb-3">
            <div class="card-lms-body text-center">
                <img src="@UiHelpers.Avatar(Model.PhotoPath)" class="avatar-lg mb-3" alt="" />
                <h5 class="mb-0">@Model.Name</h5>
                <div class="text-muted mb-2"><code>@Model.StudentID</code></div>
                @if (Model.User?.IsActive == false) { <span class="badge bg-danger mb-2">Inactive</span> }
                <ul class="list-clean text-start mt-3 small">
                    <li><i class="fa-regular fa-envelope me-2 text-brand"></i>@Model.Email</li>
                    <li><i class="fa-solid fa-phone me-2 text-brand"></i>@(Model.Contact ?? "—")</li>
                    <li><i class="fa-solid fa-location-dot me-2 text-brand"></i>@(Model.Address ?? "—")</li>
                    <li><i class="fa-solid fa-cake-candles me-2 text-brand"></i>@(Model.DateOfBirth ?? "—")</li>
                    <li><i class="fa-solid fa-user me-2 text-brand"></i>Father: @(Model.FatherName ?? "—") · Mother: @(Model.MotherName ?? "—")</li>
                </ul>
                <div class="d-flex gap-2 justify-content-center mt-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen me-1"></i>Edit</a>
                    <a href="/Admin/Enrollment/Create?studentId=@Model.Id" class="btn btn-sm btn-brand"><i class="fa-solid fa-plus me-1"></i>Enroll in course</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card-lms mb-3">
            <div class="card-lms-header"><h5>Enrollments</h5></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Course</th><th>Status</th><th>Progress</th><th>Paid</th><th>Enrolled</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Enrollments.OrderByDescending(e => e.EnrolledAt))
                        {
                            var p = progress.GetValueOrDefault(e.Id, new CourseProgress(0, 0));
                            <tr>
                                <td class="fw-semibold">@e.Course.Title</td>
                                <td><span class="badge @UiHelpers.StatusBadge(e.Status)">@e.Status</span></td>
                                <td style="min-width:140px">
                                    <div class="progress mb-1"><div class="progress-bar" style="width:@p.Percent%"></div></div>
                                    <small class="text-muted">@p.Completed / @p.Total lessons</small>
                                </td>
                                <td class="text-nowrap">@UiHelpers.Money(e.Amount) <small class="text-muted d-block">@e.PaymentMethod @e.TransactionId</small></td>
                                <td class="text-nowrap">@e.EnrolledAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                        @if (!Model.Enrollments.Any())
                        {
                            <tr><td colspan="5" class="empty-state">Not enrolled in any course yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card-lms h-100">
                    <div class="card-lms-header"><h6>Assignment submissions</h6></div>
                    <div class="card-lms-body">
                        <ul class="list-clean">
                            @foreach (var s in submissions)
                            {
                                <li class="d-flex justify-content-between gap-2">
                                    <div><div class="fw-semibold">@s.Assignment.Title</div><small class="text-muted">@s.Assignment.Course.Title</small></div>
                                    <div class="text-end text-nowrap">
                                        @if (s.Marks != null) { <span class="fw-bold">@s.Marks.Value.ToString("0.##")</span><small class="text-muted">/@s.Assignment.MaxMarks</small> }
                                        else { <span class="badge bg-warning text-dark">Not graded</span> }
                                    </div>
                                </li>
                            }
                            @if (!submissions.Any()) { <li class="text-muted">No submissions.</li> }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card-lms h-100">
                    <div class="card-lms-header"><h6>Quiz attempts</h6></div>
                    <div class="card-lms-body">
                        <ul class="list-clean">
                            @foreach (var a in attempts)
                            {
                                <li class="d-flex justify-content-between gap-2">
                                    <div><div class="fw-semibold">@a.Quiz.Title</div><small class="text-muted">@a.Quiz.Course.Title · @a.SubmittedAt?.ToString("dd MMM")</small></div>
                                    <div class="text-end"><span class="badge @(a.Passed ? "bg-success" : "bg-danger")">@a.Percent%</span></div>
                                </li>
                            }
                            @if (!attempts.Any()) { <li class="text-muted">No quiz attempts.</li> }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
