@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["PanelName"] = "Admin Panel";
}
@section Sidebar {
    <a href="/Admin" class="@ViewContext.ActiveIf("Home", "Index")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>

    <div class="dash-nav-heading">Academics</div>
    <a href="/Admin/CourseCategory" class="@ViewContext.ActiveIf("CourseCategory")"><i class="fa-solid fa-layer-group"></i> Categories</a>
    <a href="/Admin/Course" class="@ViewContext.ActiveIf("Course")@ViewContext.ActiveIf("Curriculum")"><i class="fa-solid fa-book"></i> Courses</a>
    <a href="/Admin/Enrollment" class="@ViewContext.ActiveIf("Enrollment")"><i class="fa-solid fa-user-check"></i> Enrollments</a>
    <a href="/Teacher/Assignments" class="@ViewContext.ActiveIf("Assignments")"><i class="fa-solid fa-list-check"></i> Assignments</a>
    <a href="/Teacher/Quizzes" class="@ViewContext.ActiveIf("Quizzes")"><i class="fa-solid fa-circle-question"></i> Quizzes</a>
    <a href="/Teacher/LiveClasses" class="@ViewContext.ActiveIf("LiveClasses")"><i class="fa-solid fa-video"></i> Live Classes</a>

    <div class="dash-nav-heading">People</div>
    <a href="/Admin/Teacher" class="@ViewContext.ActiveIf("Teacher")"><i class="fa-solid fa-person-chalkboard"></i> Teachers</a>
    <a href="/Admin/Student" class="@ViewContext.ActiveIf("Student")"><i class="fa-solid fa-graduation-cap"></i> Students</a>
    <a href="/Admin/ManageUser" class="@ViewContext.ActiveIf("ManageUser")"><i class="fa-solid fa-user-shield"></i> Admin Users</a>

    <div class="dash-nav-heading">Office</div>
    <a href="/Admin/Inquiry" class="@ViewContext.ActiveIf("Inquiry")"><i class="fa-solid fa-envelope-open-text"></i> Inquiries</a>
    <a href="/Admin/Announcement" class="@ViewContext.ActiveIf("Announcement")"><i class="fa-solid fa-bullhorn"></i> Announcements</a>
    <a href="/Admin/PaymentMethod" class="@ViewContext.ActiveIf("PaymentMethod")"><i class="fa-solid fa-wallet"></i> Payment Methods</a>
    <a href="/Admin/Report" class="@ViewContext.ActiveIf("Report")"><i class="fa-solid fa-chart-column"></i> Reports</a>
}
@section Styles { @RenderSection("Styles", required: false) }
@section Scripts { @RenderSection("Scripts", required: false) }
@RenderBody()
