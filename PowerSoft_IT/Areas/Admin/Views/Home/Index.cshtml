<style>
	.profile-card {
		background: #fff;
		padding: 25px;
		width: 220px;
	}

	.fa-user {
		color: var(--secondary-color);
		font-weight: bold;
		padding: 3px;
		border-radius: 30px;
		border: 1px solid var(--secondary-color);
	}

	.fa-envelope {
		color: var(--secondary-color);
		font-weight: bold;
		padding: 3px;
	}
</style>

<main class="col-md-10 px-4 admin">
	<!-- Header -->
	<div class="header mt-4">
		<div class="d-flex justify-content-between align-items-center">
			<div>
				<h3>Welcome back, Admin!</h3>
				<p>Monitor and manage all system activities efficiently.</p>
			</div>
			<div class="Profile">
				<div type="button" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
					<img src="~/Images/users/male_admin.jpeg" alt="Admin Profile" class="profile-img me-3" />
					<span><strong>@User.FindFirst("RoleName")?.Value</strong></span>
				</div>
				<div class="profile-card border-0 shadow dropdown-menu dropdown-menu-end" id="profileCard">
					<h5> @User.FindFirst("RoleName")?.Value</h5>
					<p><strong><img width="25" height="25" src="https://img.icons8.com/external-royyan-wijaya-detailed-outline-royyan-wijaya/50/1abc9c/external-user-circle-user-royyan-wijaya-detailed-outline-royyan-wijaya.png" alt="external-user-circle-user-royyan-wijaya-detailed-outline-royyan-wijaya" /></strong> @User.Identity.Name</p>
					<p><strong><img width="25" height="25" src="https://img.icons8.com/external-kiranshastry-solid-kiranshastry/64/1abc9c/external-email-business-kiranshastry-solid-kiranshastry.png" alt="external-email-business-kiranshastry-solid-kiranshastry" /></strong> @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
					<h6>
						<a href="/Home/Logout " class="mt-2 nav-link"><img width="20" height="20" src="https://img.icons8.com/ios-filled/50/1abc9c/logout-rounded.png" alt="logout-rounded" /> Logout </a>
					</h6>
				</div>
			</div>

		</div>
	</div>



	<!-- Search -->
	<div class="col-5 mt-5">
		<div class="input-group">
			<span class="input-group-text"> <i class="fa-solid fa-magnifying-glass"></i></span>
			<input type="text" class="form-control" placeholder="Search">
		</div>
	</div>
	<!-- Dashboard Cards -->
	<div class="row mt-2 g-4">
		<div class="col-md-3">
			<div class="dashboard-card">
				<i class="fas fa-users fa-3x mb-3 text-primary"></i>
				<h4>450</h4>
				<p>Registered Users</p>
			</div>
		</div>
		<div class="col-md-3">
			<div class="dashboard-card">
				<i class="fas fa-book fa-3x mb-3 text-success"></i>
				<h4>35</h4>
				<p>Active Courses</p>
			</div>
		</div>
		<div class="col-md-3">
			<div class="dashboard-card">
				<i class="fas fa-file-alt fa-3x mb-3 text-warning"></i>
				<h4>12</h4>
				<p>Pending Reports</p>
			</div>
		</div>
		<div class="col-md-3">
			<div class="dashboard-card">
				<i class="fas fa-cogs fa-3x mb-3 text-danger"></i>
				<h4>Settings</h4>
				<p>System Configurations</p>
			</div>
		</div>
	</div>

	<!-- Recent Activities & Reports -->
	<div class="row mt-5 g-4">
		<div class="col-md-6">
			<div class="dashboard-card">
				<h5>Recent User Activity</h5>
				<ul class="list-unstyled mt-3">
					<li><strong>John Doe</strong> registered a new course.</li>
					<li><strong>Jane Smith</strong> updated assignment grades.</li>
					<li><strong>Admin</strong> changed system settings.</li>
				</ul>
			</div>
		</div>
		<div class="col-md-6">
			<div class="dashboard-card">
				<h5>System Reports</h5>
				<ul class="list-unstyled mt-3">
					<li><strong>Weekly User Sign-ups:</strong> 50 new users.</li>
					<li><strong>Course Completion Rate:</strong> 78%</li>
					<li><strong>Pending Tasks:</strong> 5 reports to review.</li>
				</ul>
			</div>
		</div>
	</div>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>

</script>
