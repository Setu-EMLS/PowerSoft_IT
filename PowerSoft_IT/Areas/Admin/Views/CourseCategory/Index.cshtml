@model List<CourseCategory>
@{
    ViewData["Title"] = "Course Categories";
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card-lms">
            <div class="card-lms-header"><h5>All categories</h5><span class="text-muted small">@Model.Count total</span></div>
            <div class="card-lms-body">
                <div class="table-responsive">
                    <table class="table datatable">
                        <thead><tr><th>#</th><th>Title</th><th>Description</th><th>Courses</th><th class="no-sort text-end">Actions</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                var c = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td class="fw-semibold">@c.Title</td>
                                    <td class="text-muted">@c.Description</td>
                                    <td><span class="badge bg-light text-dark border">@c.Courses.Count</span></td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="inline-form" data-confirm="Delete category '@c.Title'?">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-lms">
            <div class="card-lms-header"><h5><i class="fa-solid fa-plus me-2 text-brand"></i>Add category</h5></div>
            <div class="card-lms-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label" for="Title">Title</label>
                        <input class="form-control" id="Title" name="Title" required minlength="3" maxlength="100" placeholder="e.g. Web Development" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Description">Description</label>
                        <textarea class="form-control" id="Description" name="Description" rows="3" maxlength="500"></textarea>
                    </div>
                    <button type="submit" class="btn btn-brand w-100">Save category</button>
                </form>
            </div>
        </div>
    </div>
</div>
