@model Quiz
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Quiz" : "Quiz Settings";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)" method="post" class="card-lms">
            <div class="card-lms-header"><h5>@ViewData["Title"]</h5></div>
            <div class="card-lms-body">
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label"></label>
                    <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                        <option value="0">— Select course —</option>
                    </select>
                    <span asp-validation-for="CourseId"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Week 1 Quiz" />
                    <span asp-validation-for="Title"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Instructions</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="TimeLimitMinutes" class="form-label"></label>
                        <input asp-for="TimeLimitMinutes" class="form-control" type="number" min="1" placeholder="No limit" />
                        <span asp-validation-for="TimeLimitMinutes"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PassPercentage" class="form-label"></label>
                        <input asp-for="PassPercentage" class="form-control" type="number" min="0" max="100" />
                        <span asp-validation-for="PassPercentage"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MaxAttempts" class="form-label"></label>
                        <input asp-for="MaxAttempts" class="form-control" type="number" min="1" placeholder="Unlimited" />
                        <span asp-validation-for="MaxAttempts"></span>
                    </div>
                </div>
            </div>
            <div class="card-lms-body border-top d-flex gap-2">
                <button type="submit" class="btn btn-brand px-4">@(isNew ? "Create & add questions" : "Save settings")</button>
                <a asp-action="@(isNew ? "Index" : "Questions")" asp-route-id="@(isNew ? (int?)null : Model.Id)" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
