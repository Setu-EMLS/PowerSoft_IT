@model Quiz
@{
    ViewData["Title"] = "Questions · " + Model.Title;
    int attemptCount = ViewBag.AttemptCount;
    var locked = attemptCount > 0;
    var letters = "ABCDEFGHIJ";
}
<div class="card-lms mb-3">
    <div class="card-lms-body d-flex flex-wrap gap-3 align-items-center">
        <div class="flex-grow-1">
            <h4 class="mb-1">@Model.Title</h4>
            <div class="text-muted small">
                @Model.Course.Title · @Model.Questions.Count questions · @Model.Questions.Sum(q => q.Marks) marks ·
                @(Model.TimeLimitMinutes != null ? Model.TimeLimitMinutes + " min" : "no time limit") · pass @Model.PassPercentage% ·
                @(Model.MaxAttempts != null ? Model.MaxAttempts + " attempt(s)" : "unlimited attempts")
            </div>
            <div class="mt-1">@if (Model.IsPublished) { <span class="badge bg-success">Published</span> } else { <span class="badge bg-secondary">Draft — students can't see it</span> }</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <form asp-action="TogglePublish" asp-route-id="@Model.Id" method="post" class="inline-form">
                <button class="btn btn-sm @(Model.IsPublished ? "btn-outline-secondary" : "btn-success")">
                    <i class="fa-solid @(Model.IsPublished ? "fa-eye-slash" : "fa-eye") me-1"></i>@(Model.IsPublished ? "Unpublish" : "Publish")
                </button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-gear me-1"></i>Settings</a>
            <a asp-action="Results" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-brand"><i class="fa-solid fa-square-poll-vertical me-1"></i>Results (@attemptCount)</a>
        </div>
    </div>
</div>

@if (locked)
{
    <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span><i class="fa-solid fa-lock me-2"></i>@attemptCount attempt(s) recorded — questions are locked so past scores stay correct.</span>
        <form asp-action="ResetAttempts" asp-route-id="@Model.Id" method="post" class="inline-form" data-confirm="Delete all @attemptCount attempts for this quiz? Students will lose these results.">
            <button class="btn btn-sm btn-outline-danger">Clear attempts</button>
        </form>
    </div>
}

<div class="row g-3">
    <div class="@(locked ? "col-12" : "col-xl-7")">
        @{ var n = 0; }
        @foreach (var q in Model.Questions)
        {
            n++;
            <div class="quiz-question">
                <div class="d-flex justify-content-between gap-2">
                    <div class="fw-semibold">@n. <span class="player-article">@q.Text</span></div>
                    <div class="text-nowrap">
                        <span class="badge bg-light text-dark border">@q.Marks mark@(q.Marks == 1 ? "" : "s")</span>
                        @if (!locked)
                        {
                            <a asp-action="EditQuestion" asp-route-id="@q.Id" class="btn btn-sm btn-link p-0 ms-2"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="DeleteQuestion" asp-route-id="@q.Id" method="post" class="inline-form" data-confirm="Delete this question?">
                                <button class="btn btn-sm btn-link text-danger p-0 ms-2"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                    </div>
                </div>
                @for (var i = 0; i < q.Options.Count; i++)
                {
                    var o = q.Options[i];
                    <div class="quiz-option @(o.IsCorrect ? "correct" : "")">
                        <strong>@letters[i % letters.Length].</strong> @o.Text
                        @if (o.IsCorrect) { <i class="fa-solid fa-check text-success ms-auto"></i> }
                    </div>
                }
            </div>
        }
        @if (!Model.Questions.Any())
        {
            <div class="card-lms"><div class="empty-state"><i class="fa-solid fa-circle-question"></i>No questions yet. Add the first one.</div></div>
        }
    </div>
    @if (!locked)
    {
        <div class="col-xl-5">
            <div class="card-lms" style="position:sticky;top:84px">
                <div class="card-lms-header"><h5><i class="fa-solid fa-plus me-2 text-brand"></i>Add question</h5></div>
                <div class="card-lms-body">
                    <form asp-action="AddQuestion" method="post">
                        <input type="hidden" name="quizId" value="@Model.Id" />
                        <partial name="_QuestionEditor" model="new QuizQuestion()" />
                        <button type="submit" class="btn btn-brand w-100">Add question</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
