@model List<Assignment>
@{
    ViewData["Title"] = "Assignments";
    int? courseId = ViewBag.CourseId;
}
<div class="page-head">
    <div>
        <h2>Assignments</h2>
        <p>Publish tasks for your students and grade their submissions.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex">
            <select name="courseId" class="form-select" asp-items="ViewBag.Courses" onchange="this.form.submit()">
                <option value="">All courses</option>
            </select>
        </form>
        <a asp-action="Create" asp-route-courseId="@courseId" class="btn btn-brand text-nowrap"><i class="fa-solid fa-plus me-1"></i> New assignment</a>
    </div>
</div>

<div class="card-lms">
    <div class="card-lms-body">
        <div class="table-responsive">
            <table class="table datatable">
                <thead><tr><th>Assignment</th><th>Course</th><th>Due</th><th>Marks</th><th>Submissions</th><th class="no-sort text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var ungraded = a.Submissions.Count(s => s.Marks == null);
                        <tr>
                            <td class="fw-semibold">@a.Title</td>
                            <td>@a.Course.Title</td>
                            <td class="text-nowrap" data-order="@(a.DueDate?.Ticks ?? long.MaxValue)">
                                @if (a.DueDate != null)
                                {
                                    @a.DueDate.Value.ToString("dd MMM yyyy, h:mm tt")
                                    @if (a.DueDate < DateTime.Now) { <span class="badge bg-secondary ms-1">Closed</span> }
                                }
                                else { <span class="text-muted">No deadline</span> }
                            </td>
                            <td>@a.MaxMarks</td>
                            <td>
                                @a.Submissions.Count
                                @if (ungraded > 0) { <span class="badge bg-warning text-dark ms-1">@ungraded to grade</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Submissions" asp-route-id="@a.Id" class="btn btn-sm btn-brand"><i class="fa-solid fa-inbox me-1"></i>Submissions</a>
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="inline-form" data-confirm="Delete '@a.Title' and all submissions?">
                                    <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
