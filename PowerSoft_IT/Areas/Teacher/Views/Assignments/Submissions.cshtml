@model Assignment
@{
    ViewData["Title"] = "Submissions · " + Model.Title;
    var students = (List<StudentEntity>)ViewBag.Students;
    var submissions = (Dictionary<int, AssignmentSubmission>)ViewBag.Submissions;
}
<div class="card-lms mb-3">
    <div class="card-lms-body">
        <div class="d-flex flex-wrap justify-content-between gap-2">
            <div>
                <h4 class="mb-1">@Model.Title</h4>
                <div class="text-muted small">@Model.Course.Title · Total marks @Model.MaxMarks · Due @(Model.DueDate?.ToString("dd MMM yyyy, h:mm tt") ?? "—")</div>
            </div>
            <div class="text-end">
                <div class="fw-bold fs-5">@submissions.Count / @students.Count</div>
                <small class="text-muted">submitted</small>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Instructions))
        {
            <hr />
            <div class="player-article small">@Model.Instructions</div>
        }
    </div>
</div>

@foreach (var s in students)
{
    submissions.TryGetValue(s.Id, out var sub);
    <div class="card-lms mb-2">
        <div class="card-lms-body">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <img src="@UiHelpers.Avatar(s.PhotoPath)" class="avatar-sm" alt="" />
                <div class="flex-grow-1">
                    <div class="fw-semibold">@s.Name <small class="text-muted">@s.StudentID</small></div>
                    @if (sub == null)
                    {
                        <span class="badge bg-light text-muted border">Not submitted</span>
                    }
                    else
                    {
                        <small class="text-muted">Submitted @sub.SubmittedAt.ToString("dd MMM yyyy, h:mm tt")</small>
                        @if (Model.DueDate != null && sub.SubmittedAt > Model.DueDate) { <span class="badge bg-danger ms-1">Late</span> }
                    }
                </div>
                @if (sub?.Marks != null)
                {
                    <span class="badge bg-success fs-6">@sub.Marks.Value.ToString("0.##") / @Model.MaxMarks</span>
                }
            </div>
            @if (sub != null)
            {
                <div class="mt-3 ps-md-5">
                    @if (!string.IsNullOrWhiteSpace(sub.Answer)) { <div class="player-article border rounded p-3 bg-light small mb-2">@sub.Answer</div> }
                    @if (!string.IsNullOrEmpty(sub.FilePath)) { <a href="@sub.FilePath" target="_blank" class="btn btn-sm btn-outline-secondary mb-2"><i class="fa-solid fa-paperclip me-1"></i>Open submitted file</a> }
                    <form asp-action="Grade" method="post" class="row g-2 align-items-end">
                        <input type="hidden" name="submissionId" value="@sub.Id" />
                        <div class="col-sm-3 col-lg-2">
                            <label class="form-label small mb-1">Marks</label>
                            <input type="number" name="marks" value="@sub.Marks?.ToString("0.##")" step="0.5" min="0" max="@Model.MaxMarks" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-sm-7 col-lg-8">
                            <label class="form-label small mb-1">Feedback</label>
                            <input name="feedback" value="@sub.Feedback" class="form-control form-control-sm" placeholder="Optional comments for the student" />
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-sm btn-brand w-100">@(sub.Marks == null ? "Grade" : "Update")</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
}
@if (!students.Any())
{
    <div class="card-lms"><div class="empty-state"><i class="fa-solid fa-users"></i>No students have access to this course yet.</div></div>
}
