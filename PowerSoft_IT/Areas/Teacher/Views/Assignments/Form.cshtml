@model Assignment
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Assignment" : "Edit Assignment";
}
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="mb-3"></div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-lms">
                <div class="card-lms-body">
                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label"></label>
                        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                            <option value="0">— Select course —</option>
                        </select>
                        <span asp-validation-for="CourseId"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Instructions" class="form-label"></label>
                        <textarea asp-for="Instructions" class="form-control" rows="9" placeholder="Explain what students need to do and how it will be marked."></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-lms mb-3">
                <div class="card-lms-body">
                    <div class="mb-3">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate" class="form-control" type="datetime-local" />
                        <small class="text-muted">Leave empty for no deadline. Late submissions are not accepted.</small>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MaxMarks" class="form-label"></label>
                        <input asp-for="MaxMarks" class="form-control" type="number" min="1" max="1000" />
                        <span asp-validation-for="MaxMarks"></span>
                    </div>
                    <label class="form-label">Attachment (optional)</label>
                    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div class="small mb-2">
                            <a href="@Model.AttachmentPath" target="_blank"><i class="fa-solid fa-paperclip me-1"></i>Current file</a>
                            <div class="form-check"><input class="form-check-input" type="checkbox" name="removeAttachment" value="true" id="rm" /><label class="form-check-label" for="rm">Remove</label></div>
                        </div>
                    }
                    <input asp-for="Attachment" type="file" class="form-control" />
                    <span asp-validation-for="Attachment"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-brand w-100 mb-2">@(isNew ? "Publish assignment" : "Save changes")</button>
            <a asp-action="Index" class="btn btn-light w-100">Cancel</a>
        </div>
    </div>
</form>
