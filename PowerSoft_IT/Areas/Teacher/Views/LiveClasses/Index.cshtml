@model List<LiveClass>
@{
    ViewData["Title"] = "Live Classes";
    var now = DateTime.Now;
}
<div class="page-head">
    <div>
        <h2>Live classes</h2>
        <p>Schedule Zoom / Google Meet sessions. Students see them in their class schedule with a join link.</p>
    </div>
    <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i> Schedule class</a>
</div>

<div class="card-lms">
    <div class="card-lms-body">
        <div class="table-responsive">
            <table class="table datatable">
                <thead><tr><th>When</th><th>Class</th><th>Course</th><th>Link</th><th>Status</th><th class="no-sort text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        var ends = l.StartsAt.AddMinutes(l.DurationMinutes);
                        var link = UiHelpers.SafeUrl(l.MeetingUrl);
                        <tr>
                            <td class="text-nowrap" data-order="@l.StartsAt.Ticks">@l.StartsAt.ToString("ddd, dd MMM yyyy")<small class="d-block text-muted">@l.StartsAt.ToString("h:mm tt") · @l.DurationMinutes min</small></td>
                            <td class="fw-semibold">@l.Title</td>
                            <td>@l.Course.Title</td>
                            <td>@if (link != null) { <a href="@link" target="_blank" rel="noopener">Open <i class="fa-solid fa-arrow-up-right-from-square small"></i></a> } else { <span class="text-muted">—</span> }</td>
                            <td>
                                @if (now > ends) { <span class="badge bg-secondary">Finished</span> }
                                else if (now >= l.StartsAt) { <span class="badge bg-danger">Live now</span> }
                                else { <span class="badge bg-primary">Upcoming</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="Delete" asp-route-id="@l.Id" method="post" class="inline-form" data-confirm="Remove this class?">
                                    <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
