@model List<Course>
@{
    ViewData["Title"] = "My Courses";
}
<div class="page-head">
    <div>
        <h2>@(User.IsInRole("Admin") ? "All courses" : "My courses")</h2>
        <p>Build the curriculum, then track how your students are progressing.</p>
    </div>
</div>

<div class="row g-3">
    @foreach (var c in Model)
    {
        var lessons = c.Sections.Sum(s => s.Lessons.Count);
        var students = c.Enrollments.Count(e => e.HasAccess);
        <div class="col-md-6 col-xl-4">
            <div class="course-card">
                <img src="@UiHelpers.CourseImage(c.ThumbnailPath)" alt="" />
                <div class="course-card-body">
                    <div class="d-flex justify-content-between">
                        <span class="badge bg-light text-dark border">@c.Coursecategory?.Title</span>
                        @if (c.IsPublished) { <span class="badge bg-success">Published</span> } else { <span class="badge bg-secondary">Draft</span> }
                    </div>
                    <h5>@c.Title</h5>
                    <div class="meta">
                        <i class="fa-solid fa-layer-group me-1"></i>@c.Sections.Count sections ·
                        <i class="fa-solid fa-circle-play mx-1"></i>@lessons lessons ·
                        <i class="fa-solid fa-users mx-1"></i>@students students
                    </div>
                    <div class="mt-auto d-flex flex-wrap gap-2 pt-2">
                        <a href="/Teacher/Curriculum/Index/@c.Id" class="btn btn-sm btn-brand"><i class="fa-solid fa-list-ol me-1"></i>Curriculum</a>
                        <a href="/Teacher/Courses/Students/@c.Id" class="btn btn-sm btn-outline-brand"><i class="fa-solid fa-users me-1"></i>Students</a>
                        <a href="/Teacher/Assignments?courseId=@c.Id" class="btn btn-sm btn-outline-secondary" title="Assignments"><i class="fa-solid fa-list-check"></i></a>
                        <a href="/Teacher/Quizzes?courseId=@c.Id" class="btn btn-sm btn-outline-secondary" title="Quizzes"><i class="fa-solid fa-circle-question"></i></a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12"><div class="card-lms"><div class="empty-state"><i class="fa-solid fa-book"></i>No courses are assigned to you yet. The admin assigns teachers to courses.</div></div></div>
    }
</div>
