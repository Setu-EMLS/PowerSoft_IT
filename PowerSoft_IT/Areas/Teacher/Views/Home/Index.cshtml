
<!-- Main Content -->
<main class="col-md-10">
    <!-- Header -->
    <div class="row mt-3">
        <div class="col-8">
            <div class="input-group">
                <span class="input-group-text"> <i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" class="form-control" placeholder="Search">
            </div>
        </div>
        <div class="col-4 text-end">
            <div class="Profile">
                <div type="button" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="\images\users\admin.jpeg" class="profile-img me-2">
                    <span><strong>@User.FindFirst("RoleName")?.Value | CSE Dept.</strong></span>
                </div>
                <div class="profile-card border-0 shadow dropdown-menu dropdown-menu-end" id="profileCard">
                    <h5> @User.FindFirst("RoleName")?.Value</h5>
                    <p><strong><img width="25" height="25" src="https://img.icons8.com/external-royyan-wijaya-detailed-outline-royyan-wijaya/50/1abc9c/external-user-circle-user-royyan-wijaya-detailed-outline-royyan-wijaya.png" alt="external-user-circle-user-royyan-wijaya-detailed-outline-royyan-wijaya" /></strong> @User.Identity.Name</p>
                    <p><strong><img width="25" height="25" src="https://img.icons8.com/external-kiranshastry-solid-kiranshastry/64/1abc9c/external-email-business-kiranshastry-solid-kiranshastry.png" alt="external-email-business-kiranshastry-solid-kiranshastry" /></strong> @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                    <h6>
                        <a href="/Home/Logout " class="mt-2 nav-link"><img width="20" height="20" src="https://img.icons8.com/ios-filled/50/1abc9c/logout-rounded.png" alt="logout-rounded" /> Logout </a>
                    </h6>
                </div>
            </div>
        </div>        
    </div>

    <!-- Welcome Banner -->
    <div class="header mt-4">
        <h3>Welcome back, @User.Identity.Name</h3>
        <strong>Your role: @User.FindFirst("RoleName")?.Value</strong>
		<p>You can monitor your all students</p>
    </div>

    <!-- Teacher Dashboard Cards -->
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-users fa-2x mb-2 text-primary"></i>
                <h5>120</h5>
                <p>Students</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-book fa-2x mb-2 text-success"></i>
                <h5>5</h5>
                <p>Courses</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-tasks fa-2x mb-2 text-warning"></i>
                <h5>8</h5>
                <p>Pending Assignments</p>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="dashboard-card">
                <h5>Recent Announcements</h5>
                <ul class="list-unstyled mt-3">
                    <li><strong>Exam Notice:</strong> Final exam on May 30th.</li>
                    <li><strong>Project:</strong> Submit by May 25th.</li>
                    <li><strong>Meeting:</strong> Faculty meeting on May 22nd.</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dashboard-card">
                <h5>Class Schedule</h5>
                <ul class="list-unstyled mt-3">
                    <li><strong>Mon:</strong> OOP 10:00 AM</li>
                    <li><strong>Tue:</strong> DBMS 12:00 PM</li>
                    <li><strong>Wed:</strong> Algorithms 2:00 PM</li>
                </ul>
            </div>
        </div>
    </div>

</main>