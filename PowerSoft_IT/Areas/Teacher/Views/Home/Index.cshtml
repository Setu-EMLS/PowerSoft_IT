@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="welcome-banner">
    <h3>Welcome back, @(Model.Teacher?.Name ?? User.GetDisplayName())!</h3>
    <p>Manage your courses, review submissions and keep your students on track.</p>
</div>

@if (Model.Teacher == null)
{
    <div class="alert alert-warning">Your login is not linked to a teacher profile yet. Please ask the admin to set it up.</div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a href="/Teacher/Courses" class="stat-card">
            <span class="stat-icon tone-teal"><i class="fa-solid fa-book-open"></i></span>
            <div><div class="stat-value">@Model.CourseCount</div><div class="stat-label">My courses</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <span class="stat-icon tone-blue"><i class="fa-solid fa-users"></i></span>
            <div><div class="stat-value">@Model.StudentCount</div><div class="stat-label">Active students</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Teacher/Assignments" class="stat-card">
            <span class="stat-icon tone-amber"><i class="fa-solid fa-file-pen"></i></span>
            <div><div class="stat-value">@Model.UngradedCount</div><div class="stat-label">Submissions to grade</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Teacher/Quizzes" class="stat-card">
            <span class="stat-icon tone-violet"><i class="fa-solid fa-circle-question"></i></span>
            <div><div class="stat-value">@Model.QuizCount</div><div class="stat-label">Quizzes</div></div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card-lms mb-3">
            <div class="card-lms-header"><h5>My courses</h5><a href="/Teacher/Courses" class="btn btn-sm btn-outline-brand">View all</a></div>
            <div class="card-lms-body">
                <ul class="list-clean">
                    @foreach (var c in Model.Courses)
                    {
                        <li class="d-flex align-items-center gap-3">
                            <img src="@UiHelpers.CourseImage(c.ThumbnailPath)" class="table-thumb" alt="" />
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold text-truncate">@c.Title</div>
                                <small class="text-muted">@c.Sections.Sum(s => s.Lessons.Count) lessons · @c.Enrollments.Count(e => e.HasAccess) students</small>
                            </div>
                            <a href="/Teacher/Curriculum/Index/@c.Id" class="btn btn-sm btn-brand text-nowrap">Manage</a>
                        </li>
                    }
                    @if (!Model.Courses.Any())
                    {
                        <li class="empty-state"><i class="fa-solid fa-book"></i>No courses are assigned to you yet.</li>
                    }
                </ul>
            </div>
        </div>
        <div class="card-lms">
            <div class="card-lms-header"><h5>Recent submissions</h5></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Student</th><th>Assignment</th><th>Submitted</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.RecentSubmissions)
                        {
                            <tr>
                                <td>@s.Student.Name</td>
                                <td>@s.Assignment.Title<small class="d-block text-muted">@s.Assignment.Course.Title</small></td>
                                <td class="text-nowrap">@s.SubmittedAt.ToString("dd MMM, h:mm tt")</td>
                                <td class="text-end">
                                    @if (s.Marks == null) { <a href="/Teacher/Assignments/Submissions/@s.AssignmentId" class="btn btn-sm btn-warning">Grade</a> }
                                    else { <span class="badge bg-success">@s.Marks.Value.ToString("0.##")/@s.Assignment.MaxMarks</span> }
                                </td>
                            </tr>
                        }
                        @if (!Model.RecentSubmissions.Any()) { <tr><td colspan="4" class="empty-state">No submissions yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card-lms">
            <div class="card-lms-header"><h5>Upcoming live classes</h5><a href="/Teacher/LiveClasses/Create" class="btn btn-sm btn-outline-brand"><i class="fa-solid fa-plus"></i></a></div>
            <div class="card-lms-body">
                <ul class="list-clean">
                    @foreach (var l in Model.UpcomingClasses)
                    {
                        <li>
                            <div class="fw-semibold">@l.Title</div>
                            <small class="text-muted d-block">@l.Course.Title</small>
                            <small><i class="fa-regular fa-clock me-1"></i>@l.StartsAt.ToString("ddd, dd MMM · h:mm tt") (@l.DurationMinutes min)</small>
                        </li>
                    }
                    @if (!Model.UpcomingClasses.Any()) { <li class="text-muted">Nothing scheduled.</li> }
                </ul>
            </div>
        </div>
    </div>
</div>
