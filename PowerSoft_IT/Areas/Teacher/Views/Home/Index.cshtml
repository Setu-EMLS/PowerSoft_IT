 <!-- Main Content -->
<main class="col-md-10">
    <!-- Header -->
    <div class="row mt-3">
        <div class="col-8">
            <input type="text" class="form-control" placeholder="Search">
        </div>
        <div class="col-4 text-end">
            <img src="https://i.pravatar.cc/40" class="profile-img me-2">
            <span><strong>Jane Smith</strong> | Computer Science Dept.</span>
        </div>
    </div>

    <!-- Welcome Banner -->
    <div class="header mt-4">
