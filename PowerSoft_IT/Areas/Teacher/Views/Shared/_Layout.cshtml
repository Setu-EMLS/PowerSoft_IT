@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["PanelName"] = "Teacher Panel";
}
@section Sidebar {
    <a href="/Teacher" class="@ViewContext.ActiveIf("Home", "Index")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>

    <div class="dash-nav-heading">Teaching</div>
    <a href="/Teacher/Courses" class="@ViewContext.ActiveIf("Courses")@ViewContext.ActiveIf("Curriculum")"><i class="fa-solid fa-book-open"></i> My Courses</a>
    <a href="/Teacher/Assignments" class="@ViewContext.ActiveIf("Assignments")"><i class="fa-solid fa-list-check"></i> Assignments</a>
    <a href="/Teacher/Quizzes" class="@ViewContext.ActiveIf("Quizzes")"><i class="fa-solid fa-circle-question"></i> Quizzes</a>
    <a href="/Teacher/LiveClasses" class="@ViewContext.ActiveIf("LiveClasses")"><i class="fa-solid fa-video"></i> Live Classes</a>
    <a href="/Teacher/Announcements" class="@ViewContext.ActiveIf("Announcements")"><i class="fa-solid fa-bullhorn"></i> Announcements</a>
}
@section Styles { @RenderSection("Styles", required: false) }
@section Scripts { @RenderSection("Scripts", required: false) }
@RenderBody()
