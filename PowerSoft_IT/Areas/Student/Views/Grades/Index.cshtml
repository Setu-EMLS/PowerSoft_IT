@using EduLearn.Services.Interfaces
@model List<Enrollment>
@{
    ViewData["Title"] = "Grades";
    var progress = (Dictionary<int, CourseProgress>)ViewBag.Progress;
    var assignments = (List<Assignment>)ViewBag.Assignments;
    var submissions = (Dictionary<int, AssignmentSubmission>)ViewBag.Submissions;
    var quizzes = (List<Quiz>)ViewBag.Quizzes;
    var best = (Dictionary<int, QuizAttempt>)ViewBag.BestAttempts;
}
<div class="page-head">
    <div>
        <h2>Grades</h2>
        <p>Your lesson progress, assignment marks and best quiz scores per course.</p>
    </div>
    <button type="button" class="btn btn-outline-secondary no-print" onclick="window.print()"><i class="fa-solid fa-print me-1"></i>Print</button>
</div>

@foreach (var e in Model)
{
    var p = progress.GetValueOrDefault(e.Id, new CourseProgress(0, 0));
    var courseAssignments = assignments.Where(a => a.CourseId == e.CourseId).ToList();
    var courseQuizzes = quizzes.Where(q => q.CourseId == e.CourseId).ToList();
    var graded = courseAssignments.Select(a => submissions.GetValueOrDefault(a.Id)).Where(s => s?.Marks != null).ToList();
    var assignmentTotal = courseAssignments.Where(a => submissions.GetValueOrDefault(a.Id)?.Marks != null).Sum(a => a.MaxMarks);
    <div class="card-lms mb-4">
        <div class="card-lms-header flex-wrap">
            <h5>@e.Course.Title</h5>
            <div class="d-flex align-items-center gap-2" style="min-width:220px">
                <div class="progress flex-grow-1"><div class="progress-bar" style="width:@p.Percent%"></div></div>
                <small class="text-muted text-nowrap">@p.Percent% lessons</small>
                @if (e.Status == EnrollmentStatus.Completed) { <span class="badge bg-success">Completed</span> }
            </div>
        </div>
        <div class="card-lms-body">
            <div class="row g-4">
                <div class="col-lg-6">
                    <h6 class="text-muted text-uppercase small">Assignments @if (graded.Any()) { <span class="badge bg-light text-dark border ms-1">@graded.Sum(s => s!.Marks!.Value).ToString("0.##") / @assignmentTotal</span> }</h6>
                    <ul class="list-clean">
                        @foreach (var a in courseAssignments)
                        {
                            var s = submissions.GetValueOrDefault(a.Id);
                            <li class="d-flex justify-content-between gap-2">
                                <a href="/Student/Assignments/Submit/@a.Id">@a.Title</a>
                                <span class="text-nowrap">
                                    @if (s?.Marks != null) { <strong>@s.Marks.Value.ToString("0.##")</strong><small class="text-muted">/@a.MaxMarks</small> }
                                    else if (s != null) { <span class="badge bg-primary">Submitted</span> }
                                    else { <span class="text-muted">—</span> }
                                </span>
                            </li>
                        }
                        @if (!courseAssignments.Any()) { <li class="text-muted small">No assignments.</li> }
                    </ul>
                </div>
                <div class="col-lg-6">
                    <h6 class="text-muted text-uppercase small">Quizzes (best attempt)</h6>
                    <ul class="list-clean">
                        @foreach (var q in courseQuizzes)
                        {
                            var b = best.GetValueOrDefault(q.Id);
                            <li class="d-flex justify-content-between gap-2">
                                <span>@q.Title</span>
                                @if (b != null) { <a href="/Student/Quizzes/Result/@b.Id" class="badge @(b.Passed ? "bg-success" : "bg-danger") text-decoration-none">@b.Percent%</a> }
                                else { <span class="text-muted">—</span> }
                            </li>
                        }
                        @if (!courseQuizzes.Any()) { <li class="text-muted small">No quizzes.</li> }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}
@if (!Model.Any())
{
    <div class="card-lms"><div class="empty-state"><i class="fa-solid fa-chart-line"></i>Enroll in a course to start tracking your grades.</div></div>
}
