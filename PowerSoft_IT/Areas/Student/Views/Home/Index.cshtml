<!-- Main Content -->
<main class="col-md-10">
    <!-- Header -->
    <div class="row mt-3">
        <div class="col-8">
            <input type="text" class="form-control" placeholder="Search courses or assignments" />
        </div>
        <div class="col-4 text-end">
            <img src="~/Images/users/male_student.jpeg" alt="Profile" class="profile-img me-2" />
            <span><strong>John Doe</strong> | Computer Science Dept.</span>
        </div>
    </div>

    <!-- Welcome Banner -->
    <div class="header mt-4">
        <h4>Welcome back, John!</h4>
        <p>Track your courses, assignments, and grades here.</p>
    </div>

    <!-- Student Dashboard Cards -->
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-book fa-2x mb-2 text-primary"></i>
                <h5>4</h5>
                <p>Enrolled Courses</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-tasks fa-2x mb-2 text-success"></i>
                <h5>3</h5>
                <p>Pending Assignments</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card">
                <i class="fas fa-chart-line fa-2x mb-2 text-warning"></i>
                <h5>87%</h5>
                <p>Current Average Grade</p>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="dashboard-card">
                <h5>Recent Announcements</h5>
                <ul class="list-unstyled mt-3">
                    <li><strong>Exam Date:</strong> Final exam on May 30th.</li>
                    <li><strong>Project Due:</strong> Submit by May 25th.</li>
                    <li><strong>Event:</strong> Career fair on June 5th.</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dashboard-card">
                <h5>Upcoming Classes</h5>
                <ul class="list-unstyled mt-3">
                    <li><strong>Mon:</strong> OOP 10:00 AM</li>
                    <li><strong>Tue:</strong> DBMS 12:00 PM</li>
                    <li><strong>Wed:</strong> Algorithms 2:00 PM</li>
                </ul>
            </div>
        </div>
    </div>
</main>