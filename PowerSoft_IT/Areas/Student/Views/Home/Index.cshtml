@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var active = Model.Courses.Where(c => c.Enrollment.Status == EnrollmentStatus.Active).ToList();
    var now = DateTime.Now;
}
<div class="welcome-banner d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h3>Welcome back, @Model.Student.Name!</h3>
        <p>Student ID: <strong>@Model.Student.StudentID</strong> · Keep learning, one lesson at a time.</p>
    </div>
    <a href="/Student/Courses/Browse" class="btn btn-light fw-semibold"><i class="fa-solid fa-magnifying-glass me-1"></i> Browse courses</a>
</div>

@if (Model.PendingEnrollmentCount > 0)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-hourglass-half me-2"></i>You have @Model.PendingEnrollmentCount enrollment request@(Model.PendingEnrollmentCount == 1 ? "" : "s") waiting for payment verification. <a href="/Student/Courses" class="alert-link">View</a>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a href="/Student/Courses" class="stat-card">
            <span class="stat-icon tone-teal"><i class="fa-solid fa-book-open"></i></span>
            <div><div class="stat-value">@active.Count</div><div class="stat-label">Courses in progress</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Student/Assignments" class="stat-card">
            <span class="stat-icon tone-amber"><i class="fa-solid fa-list-check"></i></span>
            <div><div class="stat-value">@Model.DueAssignments.Count</div><div class="stat-label">Assignments due</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Student/Grades" class="stat-card">
            <span class="stat-icon tone-blue"><i class="fa-solid fa-chart-line"></i></span>
            <div><div class="stat-value">@(Model.AverageQuizPercent != null ? Model.AverageQuizPercent + "%" : "—")</div><div class="stat-label">Quiz average</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Student/Certificates" class="stat-card">
            <span class="stat-icon tone-violet"><i class="fa-solid fa-award"></i></span>
            <div><div class="stat-value">@Model.CertificateCount</div><div class="stat-label">Certificates</div></div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card-lms mb-3">
            <div class="card-lms-header"><h5>Continue learning</h5><a href="/Student/Courses" class="btn btn-sm btn-outline-brand">My courses</a></div>
            <div class="card-lms-body">
                <div class="row g-3">
                    @foreach (var item in Model.Courses.Take(4))
                    {
                        var c = item.Enrollment.Course;
                        <div class="col-md-6">
                            <div class="d-flex gap-3 align-items-center border rounded-3 p-2 h-100">
                                <img src="@UiHelpers.CourseImage(c.ThumbnailPath)" alt="" style="width:96px;aspect-ratio:16/9;object-fit:cover;border-radius:8px" />
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate">@c.Title</div>
                                    <div class="progress my-1"><div class="progress-bar" style="width:@item.Progress.Percent%"></div></div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">@item.Progress.Percent% complete</small>
                                        <a href="/Student/Learn/Index/@c.Id" class="btn btn-sm btn-brand py-0">@(item.Progress.Completed == 0 ? "Start" : item.Enrollment.Status == EnrollmentStatus.Completed ? "Review" : "Continue")</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (!Model.Courses.Any())
                    {
                        <div class="col-12 empty-state"><i class="fa-solid fa-book-open"></i>You're not enrolled in any course yet. <a href="/Student/Courses/Browse">Find a course</a> to get started.</div>
                    }
                </div>
            </div>
        </div>

        <div class="card-lms">
            <div class="card-lms-header"><h5>Assignments due</h5><a href="/Student/Assignments" class="btn btn-sm btn-outline-brand">All assignments</a></div>
            <div class="card-lms-body">
                <ul class="list-clean">
                    @foreach (var a in Model.DueAssignments)
                    {
                        <li class="d-flex justify-content-between align-items-center gap-2">
                            <div>
                                <div class="fw-semibold">@a.Title</div>
                                <small class="text-muted">@a.Course.Title · @(a.DueDate != null ? "Due " + a.DueDate.Value.ToString("dd MMM, h:mm tt") : "No deadline")</small>
                            </div>
                            <a href="/Student/Assignments/Submit/@a.Id" class="btn btn-sm btn-outline-brand text-nowrap">Submit</a>
                        </li>
                    }
                    @if (!Model.DueAssignments.Any()) { <li class="text-muted"><i class="fa-solid fa-circle-check text-success me-1"></i>You're all caught up.</li> }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card-lms mb-3">
            <div class="card-lms-header"><h5>Upcoming classes</h5><a href="/Student/Schedule" class="btn btn-sm btn-outline-brand">Schedule</a></div>
            <div class="card-lms-body">
                <ul class="list-clean">
                    @foreach (var l in Model.UpcomingClasses)
                    {
                        var link = UiHelpers.SafeUrl(l.MeetingUrl);
                        var live = now >= l.StartsAt;
                        <li>
                            <div class="d-flex justify-content-between gap-2">
                                <div>
                                    <div class="fw-semibold">@l.Title @if (live) { <span class="badge bg-danger">Live</span> }</div>
                                    <small class="text-muted d-block">@l.Course.Title</small>
                                    <small><i class="fa-regular fa-clock me-1"></i>@l.StartsAt.ToString("ddd, dd MMM · h:mm tt")</small>
                                </div>
                                @if (link != null) { <a href="@link" target="_blank" rel="noopener" class="btn btn-sm @(live ? "btn-danger" : "btn-outline-secondary") align-self-start">Join</a> }
                            </div>
                        </li>
                    }
                    @if (!Model.UpcomingClasses.Any()) { <li class="text-muted">No live classes scheduled.</li> }
                </ul>
            </div>
        </div>
        <div class="card-lms">
            <div class="card-lms-header"><h5>Announcements</h5><a href="/Student/Announcements" class="btn btn-sm btn-outline-brand">All</a></div>
            <div class="card-lms-body">
                <ul class="list-clean">
                    @foreach (var a in Model.Announcements)
                    {
                        <li>
                            <div class="fw-semibold">@a.Title</div>
                            <small class="text-muted">@(a.Course?.Title ?? "Everyone") · @a.CreatedAt.ToString("dd MMM")</small>
                            <div class="small text-truncate">@a.Message</div>
                        </li>
                    }
                    @if (!Model.Announcements.Any()) { <li class="text-muted">Nothing new.</li> }
                </ul>
            </div>
        </div>
    </div>
</div>
