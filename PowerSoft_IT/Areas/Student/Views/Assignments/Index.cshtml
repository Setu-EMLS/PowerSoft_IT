@model List<Assignment>
@{
    ViewData["Title"] = "Assignments";
    var submissions = (Dictionary<int, AssignmentSubmission>)ViewBag.Submissions;
    var now = DateTime.Now;
}
<div class="page-head">
    <div>
        <h2>Assignments</h2>
        <p>Submit your work before the deadline. Your teacher grades it and leaves feedback.</p>
    </div>
</div>

<div class="card-lms">
    <div class="card-lms-body">
        <div class="table-responsive">
            <table class="table datatable">
                <thead><tr><th>Assignment</th><th>Course</th><th>Due</th><th>Status</th><th class="no-sort text-end"></th></tr></thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        submissions.TryGetValue(a.Id, out var sub);
                        var overdue = sub == null && a.DueDate != null && a.DueDate < now;
                        <tr>
                            <td class="fw-semibold">@a.Title</td>
                            <td>@a.Course.Title</td>
                            <td class="text-nowrap" data-order="@(a.DueDate?.Ticks ?? long.MaxValue)">@(a.DueDate?.ToString("dd MMM yyyy, h:mm tt") ?? "No deadline")</td>
                            <td>
                                @if (sub?.Marks != null) { <span class="badge bg-success">Graded: @sub.Marks.Value.ToString("0.##")/@a.MaxMarks</span> }
                                else if (sub != null) { <span class="badge bg-primary">Submitted</span> }
                                else if (overdue) { <span class="badge bg-danger">Missed</span> }
                                else { <span class="badge bg-warning text-dark">To do</span> }
                            </td>
                            <td class="text-end">
                                <a href="/Student/Assignments/Submit/@a.Id" class="btn btn-sm @(sub == null && !overdue ? "btn-brand" : "btn-outline-secondary")">@(sub == null && !overdue ? "Submit" : "View")</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="empty-state"><i class="fa-solid fa-list-check"></i>No assignments yet.</div>
        }
    </div>
</div>
