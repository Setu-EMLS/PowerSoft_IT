@using EduLearn.Services.Interfaces
@model List<Enrollment>
@{
    ViewData["Title"] = "My Courses";
    var progress = (Dictionary<int, CourseProgress>)ViewBag.Progress;
    var withAccess = Model.Where(e => e.HasAccess).ToList();
    var requests = Model.Where(e => !e.HasAccess).ToList();
}
<div class="page-head">
    <div>
        <h2>My courses</h2>
        <p>Pick up where you left off.</p>
    </div>
    <a href="/Student/Courses/Browse" class="btn btn-brand"><i class="fa-solid fa-magnifying-glass me-1"></i> Browse courses</a>
</div>

@if (requests.Any())
{
    <div class="card-lms mb-4">
        <div class="card-lms-header"><h5>Enrollment requests</h5></div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>Course</th><th>Payment</th><th>Requested</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in requests)
                    {
                        <tr>
                            <td class="fw-semibold">@e.Course.Title</td>
                            <td>@UiHelpers.Money(e.Amount) <small class="text-muted d-block">@e.PaymentMethod @(string.IsNullOrEmpty(e.TransactionId) ? "" : "· " + e.TransactionId)</small></td>
                            <td class="text-nowrap">@e.EnrolledAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @UiHelpers.StatusBadge(e.Status)">@(e.Status == EnrollmentStatus.Pending ? "Waiting for verification" : e.Status.ToString())</span>
                                @if (!string.IsNullOrEmpty(e.AdminNote)) { <small class="d-block text-muted">@e.AdminNote</small> }
                            </td>
                            <td class="text-end">
                                @if (e.Status == EnrollmentStatus.Rejected || e.Status == EnrollmentStatus.Cancelled)
                                {
                                    <a href="/Student/Enroll/Index/@e.CourseId" class="btn btn-sm btn-outline-brand">Try again</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="row g-3">
    @foreach (var e in withAccess)
    {
        var p = progress.GetValueOrDefault(e.Id, new CourseProgress(0, 0));
        <div class="col-md-6 col-xl-4">
            <div class="course-card">
                <img src="@UiHelpers.CourseImage(e.Course.ThumbnailPath)" alt="" />
                <div class="course-card-body">
                    <div class="d-flex justify-content-between">
                        <span class="badge bg-light text-dark border">@e.Course.Coursecategory?.Title</span>
                        @if (e.Status == EnrollmentStatus.Completed) { <span class="badge bg-success"><i class="fa-solid fa-award me-1"></i>Completed</span> }
                    </div>
                    <h5>@e.Course.Title</h5>
                    <div class="meta"><i class="fa-solid fa-person-chalkboard me-1"></i>@(e.Course.Teacher?.Name ?? "EduLearn")</div>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between small text-muted mb-1"><span>@p.Completed / @p.Total lessons</span><span>@p.Percent%</span></div>
                        <div class="progress mb-3"><div class="progress-bar" style="width:@p.Percent%"></div></div>
                        <div class="d-flex gap-2">
                            <a href="/Student/Learn/Index/@e.CourseId" class="btn btn-brand btn-sm flex-grow-1">@(p.Completed == 0 ? "Start course" : e.Status == EnrollmentStatus.Completed ? "Review course" : "Continue")</a>
                            @if (e.Status == EnrollmentStatus.Completed)
                            {
                                <a href="/Student/Certificates/View/@e.Id" class="btn btn-outline-brand btn-sm" title="Certificate"><i class="fa-solid fa-award"></i></a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!withAccess.Any())
    {
        <div class="col-12"><div class="card-lms"><div class="empty-state"><i class="fa-solid fa-book-open"></i>No courses yet. <a href="/Student/Courses/Browse">Browse the catalog</a> to enroll.</div></div></div>
    }
</div>
