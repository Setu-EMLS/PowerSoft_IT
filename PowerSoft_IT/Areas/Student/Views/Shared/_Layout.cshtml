@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["PanelName"] = "Student Panel";
}
@section Sidebar {
    <a href="/Student" class="@ViewContext.ActiveIf("Home", "Index")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>

    <div class="dash-nav-heading">Learning</div>
    <a href="/Student/Courses" class="@ViewContext.ActiveIf("Courses", "Index")@ViewContext.ActiveIf("Learn")"><i class="fa-solid fa-book-open"></i> My Courses</a>
    <a href="/Student/Courses/Browse" class="@ViewContext.ActiveIf("Courses", "Browse")@ViewContext.ActiveIf("Enroll")"><i class="fa-solid fa-magnifying-glass"></i> Browse Courses</a>
    <a href="/Student/Assignments" class="@ViewContext.ActiveIf("Assignments")"><i class="fa-solid fa-list-check"></i> Assignments</a>
    <a href="/Student/Quizzes" class="@ViewContext.ActiveIf("Quizzes")"><i class="fa-solid fa-circle-question"></i> Quizzes</a>
    <a href="/Student/Grades" class="@ViewContext.ActiveIf("Grades")"><i class="fa-solid fa-chart-line"></i> Grades</a>
    <a href="/Student/Schedule" class="@ViewContext.ActiveIf("Schedule")"><i class="fa-regular fa-calendar"></i> Class Schedule</a>
    <a href="/Student/Announcements" class="@ViewContext.ActiveIf("Announcements")"><i class="fa-solid fa-bullhorn"></i> Announcements</a>
    <a href="/Student/Certificates" class="@ViewContext.ActiveIf("Certificates")"><i class="fa-solid fa-award"></i> Certificates</a>
}
@section Styles { @RenderSection("Styles", required: false) }
@section Scripts { @RenderSection("Scripts", required: false) }
@RenderBody()
