<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Student Dashboard </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar text-white">
                <div class="text-center mb-4">
                    <i class="fas fa-user-graduate fa-3x"></i>
                </div>
                <a href="#" class="active"><i class="fas fa-home me-2"></i> Dashboard</a>
                <a href="#"><i class="fas fa-book-open me-2"></i> My Courses</a>
                <a href="#"><i class="fas fa-tasks me-2"></i> Assignments</a>
                <a href="#"><i class="fas fa-chart-bar me-2"></i> Grades</a>
                <a href="#"><i class="fas fa-bell me-2"></i> Announcements</a>
                <a href="/home/logout"><i class="fas fa-sign-out-alt me-2"></i> Logout</a>
            </div>

          @RenderBody();
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
