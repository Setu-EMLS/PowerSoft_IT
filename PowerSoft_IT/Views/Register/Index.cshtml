@model PowerSoft_IT.Models.User
<div id="login">
	<form id="RegisterFrm" method="post" class="show" asp-action="SignUp" asp-controller="Home" enctype="multipart/form-data">
		<div>
			<a href="/" class="backToHome shadow"><i class="fa-solid fa-arrow-left"></i></a>
			<h1>Register</h1>
			<div class="input-group mb-4 mt-4">
				<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-user-secret text-primary"></i></span>
				<input type="text" class="form-control" required placeholder="Name" aria-label="Name" name="FullName" aria-describedby="basic-addon1">
			</div>
			<div class="input-group mb-4 mt-4">
				<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-phone text-primary"></i></span>
				<input type="tel" class="form-control" required placeholder="MobileNo" aria-label="MobileNo" name="MobileNo" aria-describedby="basic-addon1">
			</div>
			<div class="input-group mb-4 mt-4">
				<span class="input-group-text" id="basic-addon1"><i class="fa-regular fa-envelope text-primary"></i></span>
				<input type="email" class="form-control" required placeholder="Email" aria-label="Email" name="Email" aria-describedby="basic-addon1">
			</div>
			<div class="input-group mb-3">
				<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-key text-primary"></i></span>
				<input type="password" id="Password" name="Password" required class="form-control" placeholder="Password" aria-label="Password" aria-describedby="basic-addon1">
				<span class="input-group-text" id="basic-addon1"><i class="fa-regular fa-eye-slash closeEye closeEye1"></i><i class="fa-solid fa-eye openEye openEye1"></i></span>
			</div>

			<div class="input-group mb-3">
				<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-key text-primary"></i></span>
				<input type="password" id="ConfirmPassword" name="ConfirmPassword" required class="form-control" placeholder="Password" aria-label="Password" aria-describedby="basic-addon1">
				<span class="input-group-text" id="basic-addon1"><i class="fa-regular fa-eye-slash closeEye closeEye2"></i><i class="fa-solid fa-eye openEye openEye2"></i></span>
			</div>
			<input type="submit" value="Register" class="btn btn-outline-primary rounded-5 btn-light registerBtn"><br />
			<input type="checkbox" />Remember me<br />
			<a href="/login">I have a account</a>
		</div>
	</form>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>

	/*======================= Password Hide Show =======================*/
	$(".openEye").hide();
	$(".closeEye").click(() => {
		$("#Password").attr('type', 'text');
		$(".closeEye").hide();
		$(".openEye").show();
	});

	$(".openEye1").click(() => {
		$("#Password").attr('type', 'password');
		$(".closeEye1").show();
		$(".openEye1").hide();
	});

	$(".openEye2").click(() => {
		$("#ConfirmPassword").attr('type', 'password');
		$(".closeEye2").show();
		$(".openEye2").hide();
	});

	$(".social-links-container").hide();
</script>