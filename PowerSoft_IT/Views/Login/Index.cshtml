@model Project_Management.Models.Login
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log in";
    ViewData["AuthHeadline"] = "Welcome back. Your next lesson is waiting.";
    var returnUrl = ViewBag.ReturnUrl as string;
}
<div class="auth-top">
    <a href="/"><i class="bi bi-arrow-left me-1"></i>Back to website</a>
    <span class="text-muted-ps">New here? <a asp-controller="Register" asp-action="Index" asp-route-returnUrl="@returnUrl">Create an account</a></span>
</div>
<div class="auth-card">
    <h1>Log in</h1>
    <p class="sub">Students, teachers and admins all sign in here.</p>
    <div class="panel">
        <form id="loginFrm" method="post" asp-controller="Home" asp-action="Login" asp-route-returnUrl="@returnUrl" class="ps-form">
            <div asp-validation-summary="All"></div>
            <div class="mb-3">
                <label class="form-label" for="Email">Email</label>
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    <input type="email" class="form-control" id="Email" name="Email" value="@Model?.Email" required autocomplete="username" placeholder="you@example.com" autofocus />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label" for="Password">Password</label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input type="password" class="form-control" id="Password" name="Password" required autocomplete="current-password" placeholder="Your password" />
                    <button type="button" class="toggle-pw" data-target="#Password" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
            </div>
            <div class="text-end mb-4">
                <a href="/ContactUs?subject=Password%20reset" class="small">Forgot password?</a>
            </div>
            <button type="submit" class="btn-ps w-100 btn-lg">Log in <i class="bi bi-arrow-right"></i></button>
        </form>
    </div>
    <p class="text-center text-muted-ps small mt-4 mb-0">
        <i class="bi bi-patch-check me-1"></i>Have a certificate to check? <a href="/Certificate/Verify">Verify it here</a>
    </p>
</div>
