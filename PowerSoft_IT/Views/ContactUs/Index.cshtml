@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Contact EduLearn in Kazipara, Mirpur, Dhaka — call, email or send us a message about courses, seminars or software projects.";
    var subject = Context.Request.Query["subject"].ToString();
}
<partial name="_PageHero" model="@(new PageHero("Let's talk", "Questions about a course, a seminar or a software project? Send us a message — we usually reply within one working day.", null, ("Contact", null)))" />

<section class="ps-section">
    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-md-6 col-lg-3" data-aos="fade-up">
                <div class="info-card"><span class="ic ic-orange"><i class="bi bi-geo-alt"></i></span><div><h5>Visit us</h5><p>@SiteInfo.AddressLine1, @SiteInfo.AddressLine2</p></div></div>
            </div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="80">
                <div class="info-card"><span class="ic ic-green"><i class="bi bi-telephone"></i></span><div><h5>Call us</h5><a href="tel:@SiteInfo.Phone">@SiteInfo.PhoneDisplay</a><a href="tel:@SiteInfo.Phone2">@SiteInfo.Phone2Display</a></div></div>
            </div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="160">
                <div class="info-card"><span class="ic ic-blue"><i class="bi bi-envelope"></i></span><div><h5>Email us</h5><a href="mailto:@SiteInfo.SupportEmail">@SiteInfo.SupportEmail</a><a href="mailto:@SiteInfo.HrEmail">@SiteInfo.HrEmail</a></div></div>
            </div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="240">
                <div class="info-card"><span class="ic ic-violet"><i class="bi bi-clock"></i></span><div><h5>Office hours</h5><p>@SiteInfo.OfficeHours</p></div></div>
            </div>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-7" data-aos="fade-up">
                <div class="form-panel h-100">
                    <h2 class="h3 mb-1" style="font-weight:800">Send us a message</h2>
                    <p class="text-muted-ps mb-4">Fill in the form and our team will get back to you.</p>
                    <form asp-controller="Inquiry" asp-action="Contact" method="post" class="ps-form">
                        <input type="hidden" name="returnUrl" value="/ContactUs" />
                        <div class="hp-field" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="cName">Your name</label>
                                <input class="form-control" id="cName" name="name" required maxlength="150" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="cEmail">Email</label>
                                <input class="form-control" id="cEmail" name="email" type="email" required maxlength="200" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="cPhone">Phone <span class="text-muted-ps fw-normal">(optional)</span></label>
                                <input class="form-control" id="cPhone" name="phone" type="tel" maxlength="30" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="cSubject">Subject</label>
                                <input class="form-control" id="cSubject" name="subject" value="@subject" maxlength="200" placeholder="Course inquiry, project, feedback..." />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="cMessage">Message</label>
                                <textarea class="form-control" id="cMessage" name="message" rows="6" required maxlength="4000"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn-ps btn-lg">Send message <i class="bi bi-send"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-5" data-aos="fade-up" data-aos-delay="100">
                <div class="map-frame h-100">
                    <iframe src="@SiteInfo.MapEmbedUrl" title="EduLearn on Google Maps" style="height:100%;min-height:380px" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
