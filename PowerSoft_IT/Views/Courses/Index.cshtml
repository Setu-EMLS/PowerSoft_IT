@model List<EduLearn.Areas.Admin.Models.Course>
@{
    ViewData["Title"] = "Courses";
    ViewData["Description"] = "Browse EduLearn courses: web development, databases, graphics design, digital marketing and more — with live classes and certificates.";
    var categories = (List<EduLearn.Areas.Admin.Models.CourseCategory>)ViewBag.Categories;
    int? selected = ViewBag.Category;
    string? q = ViewBag.Q;
}
<partial name="_PageHero" model="@(new PageHero("Explore our courses", "Industry-focused courses taught by experienced mentors. Learn at your own pace, join live classes and earn a certificate when you finish.", null, ("Courses", null)))" />

<section class="ps-section">
    <div class="container">
        <div class="filter-bar">
            <div class="chips">
                <a href="/Courses" class="chip @(selected == null && string.IsNullOrEmpty(q) ? "active" : "")">All courses</a>
                @foreach (var c in categories)
                {
                    <a href="/Courses?category=@c.Id" class="chip @(selected == c.Id ? "active" : "")">@c.Title</a>
                }
            </div>
            <form method="get" action="/Courses" class="ps-form search-pill">
                <i class="bi bi-search"></i>
                <input type="search" name="q" value="@q" class="form-control" placeholder="Search courses" aria-label="Search courses" />
            </form>
        </div>

        @if (!string.IsNullOrEmpty(q))
        {
            <p class="text-muted-ps mb-4">@Model.Count result@(Model.Count == 1 ? "" : "s") for <strong class="text-navy">“@q”</strong> · <a href="/Courses">clear search</a></p>
        }

        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-md-6 col-lg-4"><partial name="_CourseCard" model="course" /></div>
            }
        </div>
        @if (!Model.Any())
        {
            <div class="empty-box">
                <i class="bi bi-search"></i>
                <h5 class="text-navy">No courses found</h5>
                <p class="mb-3">Try another search, or join our free seminar and we'll help you pick the right course.</p>
                <button type="button" class="btn-ps" data-bs-toggle="modal" data-bs-target="#seminarModal">Join free seminar</button>
            </div>
        }
    </div>
</section>
