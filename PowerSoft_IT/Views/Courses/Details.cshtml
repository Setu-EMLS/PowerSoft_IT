@model EduLearn.Areas.Admin.Models.Course
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.ShortDescription ?? Model.Title;
    int taken = ViewBag.Taken;
    var myStatus = ViewBag.MyStatus as EnrollmentStatus?;
    var lessons = Model.Sections.SelectMany(s => s.Lessons).ToList();
    var minutes = lessons.Sum(l => l.DurationMinutes ?? 0);
    var seatsLeft = Model.Seats > 0 ? Math.Max(0, Model.Seats.Value - taken) : (int?)null;
    var isStaff = User.IsInRole("Admin") || User.IsInRole("Teacher");
    var teacher = Model.Teacher;
    var teacherName = teacher?.Name ?? "EduLearn";
    var initials = string.Concat(teacherName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
}

<section class="page-hero course-hero">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <ol class="crumbs">
                    <li><a href="/"><i class="bi bi-house-door me-1"></i>Home</a></li>
                    <li><a href="/Courses">Courses</a></li>
                    @if (Model.Coursecategory != null) { <li><a href="/Courses?category=@Model.CategoryId">@Model.Coursecategory.Title</a></li> }
                </ol>
                <h1>@Model.Title</h1>
                @if (!string.IsNullOrEmpty(Model.ShortDescription)) { <p class="sub">@Model.ShortDescription</p> }
                <div class="meta-row">
                    <span><i class="bi bi-person-video3"></i>@teacherName</span>
                    @if (!string.IsNullOrEmpty(Model.Level)) { <span><i class="bi bi-bar-chart"></i>@Model.Level</span> }
                    @if (!string.IsNullOrEmpty(Model.Duration)) { <span><i class="bi bi-calendar3"></i>@Model.Duration</span> }
                    <span><i class="bi bi-play-circle"></i>@lessons.Count lessons @(minutes > 0 ? $"· {minutes / 60}h {minutes % 60}m" : "")</span>
                    <span><i class="bi bi-patch-check"></i>Certificate included</span>
                </div>
            </div>
        </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0,44 C360,76 640,8 980,30 C1180,44 1320,34 1440,20 L1440,70 L0,70 Z" fill="#ffffff" /></svg>
</section>

<section class="pb-5 course-body">
    <div class="container">
        <div class="row g-4 flex-lg-row-reverse">
            <!-- Enroll card -->
            <div class="col-lg-4">
                <div class="enroll-card">
                    <div class="thumb"><img src="@UiHelpers.CourseImage(Model.ThumbnailPath)" alt="@Model.Title" /></div>
                    <div class="inner">
                        <div class="d-flex align-items-end justify-content-between mb-3">
                            <span class="price @(Model.IsFree ? "free" : "")">@UiHelpers.Money(Model.Price)</span>
                            @if (seatsLeft != null)
                            {
                                <span class="badge-soft @(seatsLeft == 0 ? "ic-pink" : "ic-orange")"><i class="bi bi-people"></i>@(seatsLeft == 0 ? "Full" : seatsLeft + " seats left")</span>
                            }
                        </div>

                        @if (myStatus == EnrollmentStatus.Active || myStatus == EnrollmentStatus.Completed)
                        {
                            <a href="/Student/Learn/Index/@Model.Id" class="btn-ps w-100 btn-lg">Continue learning <i class="bi bi-arrow-right"></i></a>
                        }
                        else if (myStatus == EnrollmentStatus.Pending)
                        {
                            <span class="btn-ps w-100 btn-lg disabled">Waiting for payment verification</span>
                        }
                        else if (isStaff)
                        {
                            <a href="/Teacher/Curriculum/Index/@Model.Id" class="btn-ps-navy w-100 btn-lg">Manage this course</a>
                        }
                        else if (seatsLeft == 0)
                        {
                            <span class="btn-ps-outline w-100 btn-lg disabled">This batch is full</span>
                            <button type="button" class="btn-ps w-100 mt-2" data-bs-toggle="modal" data-bs-target="#seminarModal">Notify me about the next batch</button>
                        }
                        else
                        {
                            <a href="/Student/Enroll/Index/@Model.Id" class="btn-ps w-100 btn-lg">@(Model.IsFree ? "Enroll for free" : "Enroll now") <i class="bi bi-arrow-right"></i></a>
                            @if (User.Identity?.IsAuthenticated != true)
                            {
                                <p class="small text-muted-ps text-center mt-2 mb-0">You'll be asked to log in or create a free account.</p>
                            }
                        }

                        <ul>
                            <li><span><i class="bi bi-person-video3"></i>Trainer</span><span>@teacherName</span></li>
                            @if (!string.IsNullOrEmpty(Model.Schedule)) { <li><span><i class="bi bi-clock"></i>Schedule</span><span>@Model.Schedule</span></li> }
                            @if (!string.IsNullOrEmpty(Model.Duration)) { <li><span><i class="bi bi-calendar3"></i>Duration</span><span>@Model.Duration</span></li> }
                            <li><span><i class="bi bi-collection-play"></i>Lessons</span><span>@lessons.Count</span></li>
                            @if (!string.IsNullOrEmpty(Model.Level)) { <li><span><i class="bi bi-bar-chart"></i>Level</span><span>@Model.Level</span></li> }
                            <li><span><i class="bi bi-translate"></i>Language</span><span>Bangla & English</span></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main content -->
            <div class="col-lg-8">
                <div class="content-card">
                    <h3>What's included</h3>
                    <div class="includes-grid">
                        <div><i class="bi bi-camera-video"></i>Live classes with your mentor</div>
                        <div><i class="bi bi-collection-play"></i>Recorded lessons, any time</div>
                        <div><i class="bi bi-file-earmark-code"></i>Assignments with feedback</div>
                        <div><i class="bi bi-ui-checks"></i>Quizzes to test yourself</div>
                        <div><i class="bi bi-patch-check"></i>Verifiable certificate</div>
                        <div><i class="bi bi-life-preserver"></i>Lifetime support</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="content-card">
                        <h3>About this course</h3>
                        <div class="prose" style="white-space:pre-wrap">@Model.Description</div>
                    </div>
                }

                <div class="content-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h3 class="mb-0">Curriculum</h3>
                        <span class="text-muted-ps small">@Model.Sections.Count sections · @lessons.Count lessons @(minutes > 0 ? $"· {minutes / 60}h {minutes % 60}m total" : "")</span>
                    </div>
                    @if (!Model.Sections.Any())
                    {
                        <p class="text-muted-ps mb-0">The curriculum is being prepared — check back soon.</p>
                    }
                    <div class="accordion curriculum" id="curriculum">
                        @for (var i = 0; i < Model.Sections.Count; i++)
                        {
                            var sec = Model.Sections[i];
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#sec-@sec.Id" aria-expanded="@(i == 0 ? "true" : "false")">
                                        <span>@sec.Title</span>
                                        <small>@sec.Lessons.Count lesson@(sec.Lessons.Count == 1 ? "" : "s")</small>
                                    </button>
                                </h2>
                                <div id="sec-@sec.Id" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#curriculum">
                                    @foreach (var l in sec.Lessons)
                                    {
                                        <div class="lesson-line">
                                            <i class="fa-solid @UiHelpers.LessonIcon(l.Type) type"></i>
                                            <span class="t">@l.Title</span>
                                            @if (l.IsPreview) { <a href="/Courses/Preview/@l.Id" class="preview"><i class="bi bi-eye me-1"></i>Preview</a> }
                                            else { <i class="bi bi-lock text-muted-ps small"></i> }
                                            @if (l.DurationMinutes > 0) { <span class="dur">@l.DurationMinutes min</span> }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="content-card">
                    <h3>Your instructor</h3>
                    <div class="instructor-box">
                        @if (!string.IsNullOrEmpty(teacher?.PhotoPath)) { <img src="@teacher.PhotoPath" class="photo" alt="@teacherName" /> }
                        else { <span class="photo ps-avatar" style="width:92px;height:92px;font-size:1.8rem">@initials</span> }
                        <div>
                            <h5 class="mb-1">@teacherName</h5>
                            <div class="text-orange fw-semibold small mb-2">@(teacher?.Designation ?? "Mentor, EduLearn")</div>
                            <p class="text-muted-ps mb-0">@(string.IsNullOrWhiteSpace(teacher?.Description) ? "An experienced EduLearn mentor who guides you through every lesson, live class and project." : teacher!.Description)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
