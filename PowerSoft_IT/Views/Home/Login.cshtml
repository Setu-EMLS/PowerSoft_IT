@model Project_Management.Models.Login
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
<div id="login">
	<form id="loginFrm" method="post" enctype="multipart/form-data" class="show" asp-controller="Home" asp-action="Login">
		<a href="/" class="backToHome shadow"><i class="fa-solid fa-arrow-left"></i></a>
		<h1>Login</h1>
		<div class="input-group mb-4 mt-4">
			<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-user-secret text-primary"></i></span>
			<input type="email" class="form-control" name="Email" required placeholder="User Email" aria-label="Email" aria-describedby="basic-addon1">
		</div>
		<div class="input-group mb-3">
			<span class="input-group-text" id="basic-addon1"><i class="fa-solid fa-key text-primary"></i></span>
			<input type="password" id="Password" required class="form-control" name="Password" placeholder="Password" aria-label="Password" aria-describedby="basic-addon1">
			<span class="input-group-text" id="basic-addon1"><i class="fa-regular fa-eye-slash closeEye"></i><i class="fa-solid fa-eye openEye"></i></span>
		</div>
		<input type="submit" class="btn btn-outline-primary btn-light rounded-5 loginBtn" value="Login"><br />

		<input type="checkbox" />Remember me<br />
		<a href="/Home/forgot">Forgot password</a><br />
		<a href="/Home/register">I have no account please register</a>
	</form>
</div>
