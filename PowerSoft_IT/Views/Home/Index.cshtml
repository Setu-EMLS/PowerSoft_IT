@using EduLearn.Areas.Admin.Models
@{
    ViewData["Title"] = "Home Page";
    var courses = ViewData["Courses"] as List<Course> ?? new();
    var mentors = ViewData["Mentors"] as List<TeacherEntity> ?? new();
    var previewLessonId = ViewData["PreviewLessonId"] as int?;

    var categories = new (string Title, string Sub, string Icon, string Tone, string Query)[]
    {
        ("Web Development", "ASP.NET Core, C# & SQL", "bi-code-slash", "ic-blue", "Web"),
        ("Mobile App Development", "Android & cross-platform", "bi-phone", "ic-violet", "Mobile"),
        ("Database Design", "Design & query data", "bi-database", "ic-teal", "Database"),
        ("Digital Marketing", "Grow any brand online", "bi-megaphone", "ic-orange", "Marketing"),
        ("Graphic Design", "Create stunning visuals", "bi-palette", "ic-pink", "Graphic"),
        ("Web Design", "Beautiful, responsive sites", "bi-layout-text-window-reverse", "ic-blue", "Design"),
        ("SEO", "Rank higher on Google", "bi-search", "ic-amber", "SEO"),
        ("Video Editing", "Edit like a pro", "bi-camera-reels", "ic-violet", "Video"),
        ("Networking", "Build & secure networks", "bi-router", "ic-green", "Network"),
        ("MS Office & Excel", "Office skills with AI", "bi-file-earmark-spreadsheet", "ic-green", "Excel"),
        ("Computer Fundamentals", "Start from the basics", "bi-pc-display-horizontal", "ic-navy", "Computer"),
        ("AutoCAD", "Technical drawing & design", "bi-rulers", "ic-orange", "AutoCAD")
    };

    var features = new (string Title, string Icon, string Tone, string Text)[]
    {
        ("Expert instructors", "bi-person-workspace", "ic-orange", "Learn from industry professionals who teach step by step, in simple language with real examples."),
        ("Lifetime support", "bi-life-preserver", "ic-pink", "All students get support for life — get expert guidance for any live project, to international standards."),
        ("Practical projects", "bi-code-square", "ic-blue", "Lab support and real-world projects so you build a portfolio employers and clients want to see."),
        ("Certificates", "bi-patch-check", "ic-violet", "Earn a certificate when you finish — employers can verify it online in seconds."),
        ("Class videos & review classes", "bi-camera-video", "ic-teal", "Recorded lectures to revise at home, plus review classes until every topic clicks."),
        ("Job placement", "bi-briefcase", "ic-green", "Placement support and freelancing guidance to start earning in local and international markets.")
    };

    var testimonials = new (string Name, string Role, string Photo, int Stars, string Text)[]
    {
        ("Rahim Hossain", "Web Development Student", "/Images/users/male_student.jpeg", 5, "The course was amazing! The instructors were supportive, and I built real-world projects that helped me land a job."),
        ("Sadia Akter", "Digital Marketing Graduate", "/Images/users/Fe_teacher.jpeg", 4, "It was a game-changer for my career. The hands-on experience and mentorship were exactly what I needed."),
        ("Jarin Islam", "Software Development Batch", "/Images/users/student.png", 5, "Great support and a modern curriculum. I especially liked how they focused on practical skills.")
    };
}

<!-- ===================== Hero ===================== -->
<section class="ps-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-up">
                <span class="eyebrow on-dark"><i class="bi bi-fire"></i> Online & classroom IT training</span>
                <h1>Learning today,<br /><span class="hl">leading</span> tomorrow.</h1>
                <p class="lead">Build your skills, achieve your goals. Get access to practical courses, expert instructors and a supportive learning community — anytime, anywhere.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="/Courses" class="btn-ps btn-lg">Start Learning Now <i class="bi bi-arrow-right"></i></a>
                    @if (previewLessonId != null)
                    {
                        <a href="/Courses/Preview/@previewLessonId" class="btn-ps-ghost btn-lg"><i class="bi bi-play-fill"></i> Watch a free lesson</a>
                    }
                    else
                    {
                        <button type="button" class="btn-ps-ghost btn-lg" data-bs-toggle="modal" data-bs-target="#seminarModal"><i class="bi bi-play-fill"></i> Join free seminar</button>
                    }
                </div>
                <div class="hero-trust">
                    <div class="faces">
                        <img src="~/assets/img/testimonials/testimonials-1.jpg" alt="" />
                        <img src="~/assets/img/testimonials/testimonials-2.jpg" alt="" />
                        <img src="~/assets/img/testimonials/testimonials-3.jpg" alt="" />
                        <img src="~/assets/img/testimonials/testimonials-4.jpg" alt="" />
                    </div>
                    <div>
                        <strong>1,200+ Happy Learners</strong>
                        <small>Join learners building real IT careers</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left" data-aos-delay="150">
                <div class="hero-visual">
                    <div class="hero-blob"></div>
                    <div class="hero-shape"></div>
                    <div class="hero-photo"><img src="~/Images/site/hero-instructor.jpg" alt="An EduLearn instructor teaching a class" /></div>

                    <div class="glass-card feature-stack">
                        <div class="row-item"><span class="ic ic-blue"><i class="bi bi-laptop"></i></span><div><strong>Learn</strong><small>At your pace</small></div></div>
                        <div class="row-item"><span class="ic ic-orange"><i class="bi bi-person-video3"></i></span><div><strong>Expert</strong><small>Instructors</small></div></div>
                        <div class="row-item"><span class="ic ic-green"><i class="bi bi-patch-check"></i></span><div><strong>Certificate</strong><small>of completion</small></div></div>
                    </div>
                    <div class="glass-card future-card">
                        <span class="ic ic-blue"><i class="bi bi-graph-up-arrow"></i></span>
                        <div><strong>Your future</strong><small>starts here</small><div class="bar"><span></span></div></div>
                    </div>
                    <div class="glass-card live-card">
                        <div class="screen"><span class="badge-live">LIVE</span><span class="play"><i class="bi bi-play-fill"></i></span></div>
                        <div class="caption">Live classes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 110" preserveAspectRatio="none" aria-hidden="true"><path d="M0,70 C320,120 520,20 820,50 C1080,76 1260,40 1440,18 L1440,110 L0,110 Z" fill="#ffffff" /></svg>
</section>

<!-- ===================== Stats ===================== -->
<div class="container ps-stats">
    <div class="inner" data-aos="fade-up">
        <div class="row g-0">
            <div class="col-6 col-md-3 stat"><span class="ic ic-blue"><i class="bi bi-people"></i></span><div><div class="num"><span data-count="1232">0</span>+</div><div class="label">Students</div></div></div>
            <div class="col-6 col-md-3 stat"><span class="ic ic-green"><i class="bi bi-journal-bookmark"></i></span><div><div class="num"><span data-count="64">0</span>+</div><div class="label">Courses</div></div></div>
            <div class="col-6 col-md-3 stat"><span class="ic ic-blue"><i class="bi bi-person-video3"></i></span><div><div class="num"><span data-count="24">0</span>+</div><div class="label">Expert Instructors</div></div></div>
            <div class="col-6 col-md-3 stat"><span class="ic ic-orange"><i class="bi bi-calendar-event"></i></span><div><div class="num"><span data-count="42">0</span>+</div><div class="label">Events & Seminars</div></div></div>
        </div>
    </div>
</div>

<!-- ===================== Categories ===================== -->
<section class="ps-section">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <span class="eyebrow">Explore Categories</span>
            <h2>Career booster categories</h2>
            <p>Choose from a wide range of categories and enhance your skills for a better future.</p>
        </div>
        <div class="row g-3">
            @for (var i = 0; i < categories.Length; i++)
            {
                var c = categories[i];
                <div class="col-6 col-lg-4 col-xl-3" data-aos="fade-up" data-aos-delay="@((i % 4) * 60)">
                    <a href="/Courses?q=@Uri.EscapeDataString(c.Query)" class="cat-tile">
                        <span class="ic @c.Tone"><i class="bi @c.Icon"></i></span>
                        <span class="txt"><strong>@c.Title</strong><small>@c.Sub</small></span>
                    </a>
                </div>
            }
        </div>
        <div class="text-center mt-4"><a href="/Courses" class="link-arrow">Browse all courses <i class="bi bi-arrow-right"></i></a></div>
    </div>
</section>

<!-- ===================== Latest courses ===================== -->
<section class="pb-5">
    <div class="container">
        <div class="courses-panel" data-aos="fade-up">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                <div class="section-head left mb-0">
                    <span class="eyebrow">Featured Courses</span>
                    <h2>Start learning with our latest courses</h2>
                    <p>Handpicked courses to help you gain in-demand skills and advance your career.</p>
                </div>
                <a href="/Courses" class="link-arrow navy">View All Courses <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var course in courses)
                {
                    <div class="col-md-6 col-xl-3"><partial name="_CourseCard" model="course" /></div>
                }
                @if (!courses.Any())
                {
                    <div class="col-12"><div class="empty-box bg-white"><i class="bi bi-journal-bookmark"></i>New courses are coming soon. Join the free seminar to hear about them first.</div></div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ===================== Why choose us (wheel) ===================== -->
<section class="ps-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="wheel">
                    <div class="wheel-ring"><i class="line"></i><i class="line l2"></i><i class="line l3"></i></div>
                    <div class="wheel-core"><partial name="_Logo" model="@("dark notag")" /></div>
                    <div class="wheel-item w1"><span class="ic ic-orange"><i class="bi bi-clock-history"></i></span>Learn anytime</div>
                    <div class="wheel-item w2"><span class="ic ic-green"><i class="bi bi-person-video3"></i></span>Expert instructors</div>
                    <div class="wheel-item w3"><span class="ic ic-teal"><i class="bi bi-infinity"></i></span>Lifetime support</div>
                    <div class="wheel-item w4"><span class="ic ic-blue"><i class="bi bi-patch-check"></i></span>Certificates</div>
                    <div class="wheel-item w5"><span class="ic ic-violet"><i class="bi bi-briefcase"></i></span>Job placement</div>
                    <div class="wheel-item w6"><span class="ic ic-amber"><i class="bi bi-kanban"></i></span>Practical projects</div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <span class="eyebrow">Why Choose Us</span>
                <h2 class="h-title mt-3 mb-3">Become an IT professional<br />— the practical way</h2>
                <p class="text-muted-ps fs-6">We provide hands-on learning, real-world projects and expert guidance to help you build a successful career in tech. Your success is our mission.</p>
                <ul class="check-list">
                    <li><i class="bi bi-check-lg"></i><span>Learn from industry experts and real-world projects</span></li>
                    <li><i class="bi bi-check-lg"></i><span>Flexible learning with recorded class videos</span></li>
                    <li><i class="bi bi-check-lg"></i><span>Get certified and showcase your skills</span></li>
                    <li><i class="bi bi-check-lg"></i><span>Join a supportive community of learners</span></li>
                </ul>
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <a href="/Register" class="btn-ps">Start Your Journey <i class="bi bi-arrow-right"></i></a>
                    <div class="trust-card">
                        <span class="ic ic-blue"><i class="bi bi-people-fill"></i></span>
                        <div><small>Trusted by</small><strong>1,200+</strong> <small class="d-inline">learners</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== Why EduLearn ===================== -->
<section class="ps-section ps-dark">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <span class="eyebrow on-dark">Our Power</span>
            <h2>Why <span class="text-gradient">EduLearn</span> is the best choice</h2>
            <p>We combine quality, flexibility and support to give you the best learning experience.</p>
        </div>
        <div class="row g-4">
            @for (var i = 0; i < features.Length; i++)
            {
                var f = features[i];
                <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="@((i % 3) * 80)">
                    <div class="feature-card row-style">
                        <span class="ic @f.Tone"><i class="bi @f.Icon"></i></span>
                        <div><h3>@f.Title</h3><p>@f.Text</p></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===================== Four steps ===================== -->
<section class="ps-section">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <span class="eyebrow">Easy Steps</span>
            <h2>From sign-up to <span class="text-gradient-blue">certificate</span> in four steps</h2>
            <p>Your journey to success is simple. Just follow these 4 steps and start learning today.</p>
        </div>
        <div class="row g-4 g-lg-5 steps-row pt-2">
            <div class="col-md-6 col-lg-3" data-aos="fade-up"><div class="step-card"><span class="num n1">1</span><h4>Choose your course</h4><p>Browse our wide range of courses, check the curriculum and pick what you love.</p></div></div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="80"><div class="step-card"><span class="num n2">2</span><h4>Enroll & pay safely</h4><p>Create a free account and pay with bKash or bank transfer — access unlocks once verified.</p></div></div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="160"><div class="step-card"><span class="num n3">3</span><h4>Learn at your own pace</h4><p>Video lessons, live classes, assignments and quizzes — on any device.</p></div></div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="240"><div class="step-card"><span class="num n4">4</span><h4>Get certified</h4><p>Finish your course and download a certificate employers can verify online.</p></div></div>
        </div>
    </div>
</section>

<!-- ===================== Free seminar ===================== -->
<section class="pb-5">
    <div class="container">
        <div class="seminar-card" data-aos="fade-up">
            <div class="row g-0 align-items-stretch">
                <div class="col-lg-5">
                    <div class="content">
                        <span class="eyebrow">Free Seminar</span>
                        <h2 class="h-title mt-3 mb-2" style="font-size:clamp(1.6rem,2.6vw,2.1rem)">Not sure where to start?<br />Join a free class first.</h2>
                        <ul class="check-list">
                            <li><i class="bi bi-check-lg"></i><span>Get a feel for our teaching style</span></li>
                            <li><i class="bi bi-check-lg"></i><span>Ask questions to our expert instructors</span></li>
                            <li><i class="bi bi-check-lg"></i><span>Explore the course content</span></li>
                            <li><i class="bi bi-check-lg"></i><span>Make the right choice for your career</span></li>
                        </ul>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <button type="button" class="btn-ps" data-bs-toggle="modal" data-bs-target="#seminarModal">Save Your Seat <i class="bi bi-arrow-right"></i></button>
                            @if (!string.IsNullOrEmpty(SiteInfo.NextSeminar))
                            {
                                <span class="next-session"><strong>Next session:</strong> @SiteInfo.NextSeminar</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="visual">
                        <span class="script" aria-hidden="true">Learn<br />Grow<br />Succeed</span>
                        <img src="~/Images/site/hero-instructor.jpg" alt="EduLearn instructor" />
                        <button type="button" class="play-btn" data-bs-toggle="modal" data-bs-target="#seminarModal" aria-label="Join the free seminar"><i class="bi bi-play-fill"></i></button>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="seminar-info">
                        <div class="tag"><span class="ic"><i class="bi bi-broadcast"></i></span><span>Free seminar<br /><small class="text-muted-ps fw-normal">& class</small></span></div>
                        <h4>Find your IT career path</h4>
                        <ul>
                            <li><i class="bi bi-people"></i>Meet our mentors</li>
                            <li><i class="bi bi-translate"></i>Language: Bangla & English</li>
                            <li><i class="bi bi-gift"></i>Free — no obligation</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== Mentors ===================== -->
@if (mentors.Any())
{
    <section class="ps-section soft">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-5">
                <div class="section-head left mb-0" data-aos="fade-up">
                    <span class="eyebrow">Our Instructors</span>
                    <h2>Learn from dedicated mentors</h2>
                    <p>Experienced professionals who teach what they practise every day.</p>
                </div>
                <a href="/Instructors" class="link-arrow navy">All Instructors <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var m in mentors)
                {
                    <div class="col-sm-6 col-lg-3" data-aos="fade-up"><partial name="_MentorCard" model="m" /></div>
                }
            </div>
        </div>
    </section>
}

<!-- ===================== Testimonials ===================== -->
<section class="ps-section" data-carousel>
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div class="section-head left mb-0" data-aos="fade-up">
                <span class="eyebrow">Testimonials</span>
                <h2>What our learners say</h2>
                <p>Real stories from people who have transformed their careers with EduLearn.</p>
            </div>
            <div class="testi-nav">
                <button type="button" data-dir="-1" aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-dir="1" aria-label="Next"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
        <div class="testi-track">
            @foreach (var t in testimonials)
            {
                <div class="testimonial-card">
                    <blockquote>“@t.Text”</blockquote>
                    <div class="stars">@(new string('★', t.Stars))<span class="text-muted-ps">@(new string('★', 5 - t.Stars))</span></div>
                    <div class="who">
                        <img src="@t.Photo" alt="@t.Name" />
                        <div><strong>@t.Name</strong><small>@t.Role</small></div>
                    </div>
                    <span class="quote"><i class="bi bi-quote"></i></span>
                </div>
            }
            <a href="/StudentsFeedback" class="testimonial-card justify-content-center align-items-center text-center">
                <i class="bi bi-chat-heart fs-2 text-orange mb-2"></i>
                <strong class="text-navy">Read more reviews</strong>
                <small class="text-muted-ps">or share your own story</small>
            </a>
        </div>
    </div>
</section>
