@model ChangePasswordViewModel
@{
    Layout = UiHelpers.DashboardLayoutFor(User);
    ViewData["Title"] = "Change Password";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card-lms">
            <div class="card-lms-header"><h5><i class="fa-solid fa-key me-2 text-brand"></i>Change your password</h5></div>
            <div class="card-lms-body">
                <form asp-controller="Home" asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Current password</label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New password</label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                    <button type="submit" class="btn btn-brand px-4">Update password</button>
                </form>
            </div>
        </div>
    </div>
</div>
