@{
    ViewData["Title"] = "About Us";
    ViewData["Description"] = "EduLearn builds job-ready IT skills through practical training and builds digital solutions — LMS, training portals, real estate and healthcare platforms.";
}
<partial name="_PageHero" model="@(new PageHero("About EduLearn", "We build powerful digital solutions — and the skilled people behind them — to empower learning and business transformation.", null, ("About us", null)))" />

<!-- Who we are -->
<section class="ps-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="about-media pe-lg-4">
                    <img src="~/assets/img/about.jpg" class="main" alt="The EduLearn team at work" />
                    <div class="exp-badge">
                        <span class="big">50+</span>
                        <small>Projects<br />delivered</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <span class="eyebrow">Who we are</span>
                <h2 class="mt-3 mb-3" style="font-size:clamp(1.9rem,3.2vw,2.6rem);font-weight:800">Training institute and software company, under one roof</h2>
                <div class="prose">
                    <p>EduLearn is a software development company and IT training institute focused on delivering high-quality web solutions — including Learning Management Systems (LMS), training portals, real estate websites, and custom platforms for healthcare, education and beyond.</p>
                    <p>With years of experience and a passionate team, we help organizations accelerate their digital presence, and help learners turn skills into careers.</p>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-sm-6"><div class="info-card"><span class="ic ic-orange"><i class="bi bi-mortarboard"></i></span><div><h5>1,200+ learners</h5><p>trained in practical IT skills</p></div></div></div>
                    <div class="col-sm-6"><div class="info-card"><span class="ic ic-blue"><i class="bi bi-code-square"></i></span><div><h5>50+ projects</h5><p>delivered across industries</p></div></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission / vision / values -->
<section class="ps-section soft">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <span class="eyebrow">What drives us</span>
            <h2>Mission, vision & values</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up">
                <div class="feature-card value-card">
                    <span class="emoji ic-orange"><i class="bi bi-bullseye"></i></span>
                    <h3>Our mission</h3>
                    <p>To deliver scalable and intuitive digital solutions that empower education and service sectors globally.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="80">
                <div class="feature-card value-card">
                    <span class="emoji ic-blue"><i class="bi bi-globe2"></i></span>
                    <h3>Our vision</h3>
                    <p>To become a globally recognized tech partner for innovative LMS and digital platforms.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="160">
                <div class="feature-card value-card">
                    <span class="emoji ic-green"><i class="bi bi-gem"></i></span>
                    <h3>Core values</h3>
                    <p>Innovation, integrity, excellence, collaboration and continuous learning.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why choose us -->
<section class="ps-section">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <span class="eyebrow">Why choose us</span>
            <h2>Why organizations and learners choose EduLearn</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3" data-aos="fade-up"><div class="feature-card"><span class="ic ic-orange"><i class="bi bi-code-slash"></i></span><h3>Expert developers</h3><p>A skilled team in ASP.NET, PHP, React and modern tech stacks.</p></div></div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="80"><div class="feature-card"><span class="ic ic-blue"><i class="bi bi-laptop"></i></span><h3>Custom LMS solutions</h3><p>Tailored platforms for training institutes and e-learning providers.</p></div></div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="160"><div class="feature-card"><span class="ic ic-violet"><i class="bi bi-speedometer2"></i></span><h3>Fast delivery</h3><p>Timely, agile delivery of projects with client satisfaction first.</p></div></div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="240"><div class="feature-card"><span class="ic ic-green"><i class="bi bi-award"></i></span><h3>Proven track record</h3><p>Successfully delivered 50+ projects across industries.</p></div></div>
        </div>
    </div>
</section>

<!-- Team -->
<section class="ps-section soft">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <span class="eyebrow">Leadership</span>
            <h2>Meet the people behind EduLearn</h2>
        </div>
        <div class="row g-5 justify-content-center">
            <div class="col-sm-6 col-lg-3" data-aos="fade-up">
                <div class="team-card">
                    <img src="~/assets/img/testimonials/testimonials-2.jpg" alt="Mst. Shahanaj Begum" />
                    <h5>Mst. Shahanaj Begum</h5>
                    <small>Founder & CEO</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="80">
                <div class="team-card">
                    <img src="~/assets/img/testimonials/testimonials-4.jpg" alt="Sadik Jahan" />
                    <h5>Sadik Jahan</h5>
                    <small>Lead Developer</small>
                </div>
            </div>
        </div>
    </div>
</section>
