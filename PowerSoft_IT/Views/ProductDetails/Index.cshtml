@* <link href="~/assets/css/main.css" rel="stylesheet" />
 *@<main class="">

    <!-- Page Title -->
    <section class="page-title bg-dark text-white py-5">
        <div class="container text-center">
            <h1>Real-estate Website Design</h1>
            <p class="lead">A complete real-estate portal with listings, map integration, and agent dashboards.</p>
        </div>
    </section>

    <!-- Product Details Section -->
    <section class="product-details py-5">
        <div class="container">
            <div class="row align-items-center">

                <!-- Product Image -->
                <div class="col-md-6 mb-4">
                    <img src="assets/img/products/real-estate.jpg" alt="Real Estate Website" class="img-fluid rounded shadow">
                </div>

                <!-- Product Description -->
                <div class="col-md-6">
                    <h2>Overview</h2>
                    <p>
                        Our Real-estate Website Design solution empowers property agencies with a modern, responsive platform.
