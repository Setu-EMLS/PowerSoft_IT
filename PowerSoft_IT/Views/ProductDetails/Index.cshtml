@{
    ViewData["Title"] = "Real-estate Website Design";
}
<partial name="_PageHero" model="@(new PageHero("Real-estate Website Design", "A complete real estate portal with listings, map integration and agent dashboards.", null, ("Products", "/Product"), ("Product details", null)))" />

<section class="ps-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <img src="~/Images/product/Redfinwebsite.webp" alt="Real estate website" class="img-fluid rounded-ps shadow-ps" />
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <span class="eyebrow">Overview</span>
                <h2 class="mt-3 mb-3" style="font-weight:800">Everything a property agency needs online</h2>
                <p class="prose">Our real-estate website solution empowers property agencies with a modern, responsive platform. It features property listings, agent profiles, Google Maps integration, user inquiries and an admin dashboard to manage everything.</p>
                <ul class="check-list">
                    <li><i class="bi bi-check-lg"></i><span>Agent login & dashboard</span></li>
                    <li><i class="bi bi-check-lg"></i><span>Property listings with images & videos</span></li>
                    <li><i class="bi bi-check-lg"></i><span>Integrated search & filters</span></li>
                    <li><i class="bi bi-check-lg"></i><span>Google Maps location view</span></li>
                    <li><i class="bi bi-check-lg"></i><span>Mobile-responsive design</span></li>
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-4">
                    <div>
                        <small class="text-muted-ps d-block">Starting from</small>
                        <span class="fw-bold text-navy" style="font-size:2rem;letter-spacing:-.03em">$249</span>
                    </div>
                    <a href="/ContactUs?subject=Purchase%3A%20Real-estate%20Website%20Design" class="btn-ps btn-lg"><i class="bi bi-cart-plus"></i> Purchase now</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ps-section soft">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <span class="eyebrow">What you'll get</span>
            <h2>Included with every purchase</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up"><div class="feature-card"><span class="ic ic-orange"><i class="bi bi-box-arrow-down"></i></span><h3>Full source code</h3><p>Complete HTML, CSS, JS and PHP / .NET source, ready to customize.</p></div></div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="80"><div class="feature-card"><span class="ic ic-blue"><i class="bi bi-person-gear"></i></span><h3>Free setup & installation</h3><p>We install and configure everything on your hosting for you.</p></div></div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="160"><div class="feature-card"><span class="ic ic-green"><i class="bi bi-shield-check"></i></span><h3>6 months bug-fix warranty</h3><p>Peace of mind after launch, with fixes at no extra cost.</p></div></div>
        </div>
    </div>
</section>
