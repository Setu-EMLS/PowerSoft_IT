                <li class="col-md-4 mb-3"><i class="bi bi-person-lines-fill text-primary"></i> Free Setup & Installation Support</li>
                <li class="col-md-4 mb-3"><i class="bi bi-shield-lock text-primary"></i> 6 Months Bug Fix Warranty</li>
            </ul>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta text-center py-5 bg-primary text-white">
        <div class="container">
            <h2>Need Customization or Hosting Support?</h2>
            <p>We offer complete deployment and customization solutions tailored to your brand.</p>
            <a href="#contact" class="btn btn-light mt-3">Contact Our Team</a>
        </div>
    </section>

</main>
