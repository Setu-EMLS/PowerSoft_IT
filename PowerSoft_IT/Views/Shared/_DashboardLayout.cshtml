@{
    var role = User.GetRoleName();
    var name = User.GetDisplayName();
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var profileUrl = role switch { "Teacher" => "/Teacher/Profile", "Student" => "/Student/Profile", _ => null };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | @ViewData["PanelName"] - EduLearn</title>
    <link rel="icon" type="image/svg+xml" href="~/Images/logo/edulearn-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/css/Dashboard.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dash-body">
    <div class="dash-shell">
        <aside class="dash-sidebar" id="dashSidebar">
            <a class="dash-brand" href="/" aria-label="EduLearn home">
                <partial name="_Logo" model="@("light notag")" />
            </a>
            <div class="dash-panel-label">@ViewData["PanelName"]</div>
            <nav class="dash-nav">
                @RenderSection("Sidebar", required: true)
                <div class="dash-nav-heading">Account</div>
                @if (profileUrl != null)
                {
                    <a href="@profileUrl" class="@ViewContext.ActiveIf("Profile")"><i class="fa-regular fa-id-badge"></i> My Profile</a>
                }
                <a href="/Home/ChangePassword" class="@ViewContext.ActiveIf("Home", "ChangePassword")"><i class="fa-solid fa-key"></i> Change Password</a>
                <a href="/Home/Logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </nav>
        </aside>
        <div class="dash-backdrop" data-dash-toggle></div>

        <div class="dash-main">
            <header class="dash-topbar">
                <button type="button" class="btn btn-light d-lg-none" data-dash-toggle aria-label="Toggle menu">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h1 class="dash-title">@ViewData["Title"]</h1>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <a href="/" class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex align-items-center">
                        <i class="fa-solid fa-globe me-1"></i> Website
                    </a>
                    <div class="dropdown">
                        <button type="button" class="dash-user" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="dash-avatar">@initials</span>
                            <span class="d-none d-sm-flex flex-column text-start lh-sm">
                                <strong>@name</strong>
                                <small class="text-muted">@role</small>
                            </span>
                            <i class="fa-solid fa-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li class="px-3 py-2 small text-muted">@User.GetEmail()</li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (profileUrl != null)
                            {
                                <li><a class="dropdown-item" href="@profileUrl"><i class="fa-regular fa-id-badge me-2"></i>My Profile</a></li>
                            }
                            <li><a class="dropdown-item" href="/Home/ChangePassword"><i class="fa-solid fa-key me-2"></i>Change Password</a></li>
                            <li><a class="dropdown-item text-danger" href="/Home/Logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="dash-content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
