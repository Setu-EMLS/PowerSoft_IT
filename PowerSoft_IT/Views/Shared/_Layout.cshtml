@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Nav(params string[] names) => names.Any(n => string.Equals(n, controller, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var displayName = signedIn ? User.GetDisplayName() : "";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var hideCta = ViewData["HideCta"] as bool? ?? false;
    // Pages that don't start with a dark hero need a solid header from the start
    var solidHeader = ViewData["SolidHeader"] as bool? ?? false;
    var description = ViewData["Description"] as string ?? "EduLearn — practical IT training in Dhaka: web development, graphics design, digital marketing and more, with live classes, recorded lessons and certificates.";
    var here = Context.Request.Path + Context.Request.QueryString;
    var socials = new (string Url, string Icon, string Label)[]
    {
        (SiteInfo.FacebookUrl, "bi-facebook", "Facebook"),
        (SiteInfo.YoutubeUrl, "bi-youtube", "YouTube"),
        (SiteInfo.LinkedinUrl, "bi-linkedin", "LinkedIn"),
        (SiteInfo.InstagramUrl, "bi-instagram", "Instagram")
    }.Where(s => !string.IsNullOrEmpty(s.Url)).ToArray();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t && t != "Home Page" ? t + " | " : "")EduLearn — @SiteInfo.Tagline</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#0A1F4E" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "EduLearn")" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/Images/site/hero-instructor.jpg")" />

    <link rel="icon" type="image/svg+xml" href="~/Images/logo/edulearn-icon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Caveat:wght@600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/assets/vendor/aos/aos.css" />
    <link rel="stylesheet" href="~/css/premium.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ps-body">

    <!-- Header -->
    <header class="ps-header @(solidHeader ? "solid" : "")">
        <nav class="navbar navbar-expand-xl">
            <div class="container">
                <a class="navbar-brand" href="/" aria-label="EduLearn home">
                    <partial name="_Logo" model="@("dark")" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#psNav" aria-controls="psNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="psNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link @Nav("Home")" href="/">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Nav("Courses")" href="/Courses">Courses</a></li>
                        <li class="nav-item"><a class="nav-link @Nav("Instructors")" href="/Instructors">Instructors</a></li>
                        <li class="nav-item"><a class="nav-link @Nav("AboutUs")" href="/AboutUs">About</a></li>
                        <li class="nav-item"><a class="nav-link @Nav("Services", "Product", "ProductDetails")" href="/Services">Services</a></li>
                        <li class="nav-item"><a class="nav-link @Nav("ContactUs")" href="/ContactUs">Contact</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 ps-header-actions">
                        <div class="search-wrap">
                            <button type="button" class="icon-btn search-toggle" aria-label="Search courses" aria-expanded="false" aria-controls="searchPop"><i class="bi bi-search"></i></button>
                            <div class="search-pop" id="searchPop">
                                <form method="get" action="/Courses" role="search">
                                    <input type="search" name="q" placeholder="Search courses…" aria-label="Search courses" />
                                    <button type="submit" class="btn-ps btn-sm" aria-label="Search"><i class="bi bi-search"></i></button>
                                </form>
                            </div>
                        </div>
                        @if (signedIn)
                        {
                            <div class="dropdown">
                                <button class="ps-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="ps-avatar">@initials</span>
                                    <span class="d-none d-sm-inline">@displayName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="@User.DashboardUrl()"><i class="bi bi-grid-1x2 me-2"></i>My dashboard</a></li>
                                    <li><a class="dropdown-item" href="/Home/ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item text-danger" href="/Home/Logout"><i class="bi bi-box-arrow-right me-2"></i>Log out</a></li>
                                </ul>
                            </div>
                            <a class="btn-ps btn-sm" href="@User.DashboardUrl()">Dashboard</a>
                        }
                        else
                        {
                            <a class="btn-ps-ghost btn-sm btn-login" href="/Login">Login</a>
                            <a class="btn-ps btn-sm" href="/Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    @if (solidHeader)
    {
        <div class="header-spacer"></div>
    }

    <main id="main">
        @RenderBody()
    </main>

    <!-- Call to action + footer -->
    @if (!hideCta)
    {
        <div class="container footer-cta-wrap">
            <div class="ps-cta">
                <div class="row align-items-center g-4 content">
                    <div class="col-lg-4">
                        <div class="laptop" aria-hidden="true">
                            <div class="screen"><partial name="_Logo" model="@("light notag")" /></div>
                            <div class="base"></div>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <span class="eyebrow on-dark">Ready to start?</span>
                        <h2>Take the next step towards your dream career!</h2>
                        <p>Join learners building real skills and a brighter future with EduLearn's mentors, live classes and hands-on projects.</p>
                        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start">
                            <a href="/Register" class="btn-ps">Get Started Now <i class="bi bi-arrow-right"></i></a>
                            <a href="/Courses" class="btn-ps-ghost">Browse Courses</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <footer class="ps-footer @(hideCta ? "" : "has-cta")">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <a href="/" class="d-inline-block mb-3" aria-label="EduLearn home"><partial name="_Logo" model="@("light")" /></a>
                    <p>We provide practical, mentor-led IT courses to help you level up your skills and achieve your career goals — with the vision of Smart Bangladesh.</p>
                    @if (socials.Any())
                    {
                        <div class="socials">
                            @foreach (var s in socials)
                            {
                                <a href="@s.Url" target="_blank" rel="noopener" aria-label="@s.Label"><i class="bi @s.Icon"></i></a>
                            }
                        </div>
                    }
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Quick Links</h5>
                    <ul class="links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/Courses">Courses</a></li>
                        <li><a href="/Instructors">Instructors</a></li>
                        <li><a href="/AboutUs">About</a></li>
                        <li><a href="/Product">Products</a></li>
                        <li><a href="/StudentsFeedback">Reviews</a></li>
                        <li><a href="/ContactUs">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Categories</h5>
                    <ul class="links">
                        <li><a href="/Courses?q=Web">Web Development</a></li>
                        <li><a href="/Courses?q=Graphic">Graphic Design</a></li>
                        <li><a href="/Courses?q=Marketing">Digital Marketing</a></li>
                        <li><a href="/Courses?q=Database">Database</a></li>
                        <li><a href="/Courses?q=Video">Video Editing</a></li>
                        <li><a href="/Courses?q=Excel">MS Office & Excel</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5>Newsletter</h5>
                    <p class="mb-2">Subscribe to get the latest course updates and free seminar dates from EduLearn.</p>
                    <form asp-controller="Inquiry" asp-action="Subscribe" method="post" class="newsletter" aria-label="Newsletter">
                        <input type="hidden" name="returnUrl" value="@here" />
                        <span class="hp-field" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></span>
                        <input type="email" name="email" placeholder="Your email address" required aria-label="Email address" />
                        <button type="submit" class="btn-ps btn-sm">Subscribe</button>
                    </form>
                    <div class="mt-4">
                        <div class="contact-line"><i class="bi bi-telephone"></i><span><a href="tel:@SiteInfo.Phone">@SiteInfo.PhoneDisplay</a></span></div>
                        <div class="contact-line"><i class="bi bi-geo-alt"></i><span>@SiteInfo.AddressLine1, @SiteInfo.AddressLine2</span></div>
                    </div>
                </div>
            </div>
            <div class="bottom d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>© @DateTime.Now.Year <strong class="text-white">EduLearn</strong>. All rights reserved. · Developed by <a href="https://developersetu.com/" target="_blank" rel="noopener">DeveloperSetu</a></span>
                <span class="legal-links"><a href="/Home/Privacy">Privacy Policy</a><a href="/Certificate/Verify">Verify Certificate</a><a href="/ContactUs?subject=Support">Support</a></span>
            </div>
        </div>
    </footer>

    <button type="button" class="ps-top" aria-label="Back to top"><i class="bi bi-arrow-up"></i></button>

    <partial name="_SeminarModal" />
    <partial name="_Toasts" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/js/premium.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
