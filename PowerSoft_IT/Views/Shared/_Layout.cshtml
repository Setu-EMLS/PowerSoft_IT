<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PowerSoft_IT</title>

    <!-- Favicon -->
    <link rel="icon" href="~/images/logo/powersoft-logo.png" />
    <link rel="apple-touch-icon" href="~/images/logo/powersoft-logo.png" />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&family=Poppins:wght@100;300;400;600;700;900&family=Raleway:wght@100;300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://unpkg.com/aos@next/dist/aos.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" rel="stylesheet">

    <!-- Local CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />

    <!-- Social Links Styling -->
    <style>
        .social-links-container {
            display: flex;
            flex-direction: column;
            position: fixed;
            left: 0;
            bottom: 20px;
            z-index: 9999;
        }

        .social-link {
            display: flex;
            align-items: center;
            flex-direction: row-reverse;
            justify-content: flex-end;
            text-decoration: none;
            color: white;
            padding: 8px;
            width: 45px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .social-link i {
            font-size: 18px;
            transition: margin-left 0.3s ease;
        }

        .social-text {
            position: absolute;
            right: 60px;
            opacity: 0;
            transition: right 0.3s ease, opacity 0.3s ease;
            font-weight: bold;
        }

        .social-link:hover {
            width: 220px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        }

        .social-link:hover .social-text {
            right: 80px;
            opacity: 1;
        }

        .social-link:hover i {
            margin-left: 15px;
        }

        .social-link.facebook {
            background-color: #3b5998;
        }

        .social-link.twitter {
            background-color: #00acee;
        }

        .social-link.instagram {
            background-color: #E1306C;
        }

        .social-link.linkedin {
            background-color: #0e76a8;
        }

        .social-link.youtube {
            background-color: #FF0000;
        }
    </style>
</head>
<body class="index-page">

    <!-- Header -->
    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container-fluid container-xl d-flex align-items-center">
            <a href="/" class="logo d-flex align-items-center me-auto">
                <img src="~/images/logo/powersoft-logo.png" alt="PowerSoft Logo" />
            </a>
            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="/" class="active">Home</a></li>
                    <li><a href="/aboutUs">About Us</a></li>
                    <li><a href="/courses">Courses</a></li>
                    <li><a href="/studentsFeedback">Students Feedback</a></li>
                    <li><a href="/services">Services</a></li>
                    <li><a href="/product">Product</a></li>
                    <li><a href="/contactUs">Contact</a></li>
                    <li class="dropdown">
                        <span>Join</span> <i class="bi bi-chevron-down toggle-dropdown"></i>
                        <ul>
                            <li><a asp-controller="Register" asp-action="Index">Register</a></li>
                            <li><a asp-controller="Login" asp-action="Index">Login</a></li>
                        </ul>
                    </li>
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>
            <a class="btn-getstarted shadow" href="/courses">Get Service</a>
        </div>
    </header>

    <!-- Floating Social Media -->
    <div class="social-links-container">
        <a href="#" class="social-link facebook"><span class="social-text">Facebook</span><i class="fab fa-facebook-f"></i></a>
        <a href="#" class="social-link twitter"><span class="social-text">Twitter</span><i class="fab fa-twitter"></i></a>
        <a href="#" class="social-link instagram"><span class="social-text">Instagram</span><i class="fab fa-instagram"></i></a>
        <a href="#" class="social-link linkedin"><span class="social-text">LinkedIn</span><i class="fab fa-linkedin-in"></i></a>
        <a href="#" class="social-link youtube"><span class="social-text">YouTube</span><i class="fab fa-youtube"></i></a>
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer id="footer" class="footer" style="background: #8acff1;">
        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a href="/" class="logo d-flex align-items-center">
                        <span class="sitename">PowerSoftIT</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>567(2nd floor) Near 285 no pillar, East-Kazipara</p>
                        <p>Kazipara, Mirpur, Dhaka-1216</p>
                        <p class="mt-3"><strong>Phone:</strong> +8801913168904</p>
                        <p><strong>Email:</strong> info@powersoftit.com</p>
                    </div>
                    <div class="social-links d-flex mt-4">
                        <a href=""><i class="bi bi-twitter-x"></i></a>
                        <a href=""><i class="bi bi-facebook"></i></a>
                        <a href=""><i class="bi bi-instagram"></i></a>
                        <a href=""><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Useful Links</h4>
                    <ul>
                        <li><a href="#">Home</a></li>
                        <li><a href="#">About us</a></li>
                        <li><a href="#">Services</a></li>
                        <li><a href="#">Terms of service</a></li>
                        <li><a href="#">Privacy policy</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Our Services</h4>
                    <ul>
                        <li><a href="#">Web Design</a></li>
                        <li><a href="#">Web Development</a></li>
                        <li><a href="#">Product Management</a></li>
                        <li><a href="#">Marketing</a></li>
                        <li><a href="#">Graphic Design</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 footer-newsletter">
                    <h4>Our Newsletter</h4>
                    <p>Subscribe to our newsletter and receive the latest news about our products and services!</p>
                    <form action="forms/newsletter.php" method="post" class="php-email-form">
                        <div class="newsletter-form">
                            <input type="email" name="email" required>
                            <input type="submit" value="Subscribe">
                        </div>
                        <div class="loading">Loading</div>
                        <div class="error-message"></div>
                        <div class="sent-message">Your subscription request has been sent. Thank you!</div>
                    </form>
                </div>
            </div>
        </div>

        <div class="copyright text-center mt-4">
            <p>© <strong class="px-1 sitename">PowerSoftIT</strong> - All Rights Reserved</p>
            <div class="credits">Developed by <a href="https://developersetu.com/">DeveloperSetu</a></div>
        </div>
    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center">
        <i class="bi bi-arrow-up-short"></i>
    </a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- JS Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
        AOS.init();
        new PureCounter();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>

    <!-- Local JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
