  <style>
    .social-links-container {
        display: flex;
        flex-direction: column;
        position: fixed;      /* Fixed position */
        left: 0;              /* Stick to left side */
        bottom: 20px;         /* 60px from bottom */
        z-index: 9999;        /* Stay on top */
        overflow: hidden;
    }

    .social-link {
        display: flex;
        align-items: center;
        flex-direction: row-reverse;
        justify-content: flex-end;
        text-decoration: none;
        color: white;
        padding: 8px 8px;
        margin: 0;
        transition: all 0.3s ease;
        position: relative;
        width: 45px;
        overflow: hidden;
        white-space: nowrap;
    }

    .social-link i {
        font-size: 18px;
        margin-left: 0;
        transition: margin-left 0.3s ease;
    }

    .social-text {
        position: absolute;
        right: 60px;
        opacity: 0;
        transition: right 0.3s ease, opacity 0.3s ease;
        font-weight: bold;
    }

    .social-link:hover {
        width: 220px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
    }

    .social-link:hover .social-text {
        right: 80px;
        opacity: 1;
        color:white;
    }

    .social-link:hover i {
        margin-left: 15px;
        color:white;
    }

    .social-link.facebook { background-color: #3b5998; }
    .social-link.twitter { background-color: #00acee; }
    .social-link.instagram { background-color: #E1306C; }
    .social-link.linkedin { background-color: #0e76a8; }
    .social-link.youtube { background-color: #FF0000; }
  </style>

</head>
<body class="index-page">

