@model string
@{
    // "light" = white text for dark backgrounds, "dark" = navy text for light backgrounds.
    // Append " notag" to hide the tagline, e.g. "dark notag".
    var variant = Model ?? "dark";
    var light = variant.Contains("light");
    var showTag = !variant.Contains("notag");
}
<span class="el-logo @(light ? "on-dark" : "")">
    <svg class="el-logo-mark" viewBox="0 0 48 40" aria-hidden="true">
        <path d="M24 2 1 12.5 24 23l18.5-8.4V27H46V12.5L24 2z" fill="currentColor" />
        <path d="M10.5 18.6v8.2c0 3.9 6 7.4 13.5 7.4s13.5-3.5 13.5-7.4v-8.2L24 24.8l-13.5-6.2z" fill="currentColor" opacity=".72" />
        <circle cx="44.2" cy="29.5" r="2.6" fill="#F7731C" />
    </svg>
    <span class="el-logo-text">
        <span class="el-logo-name">Edu<span>Learn</span></span>
        @if (showTag) { <span class="el-logo-tag">@SiteInfo.Tagline</span> }
    </span>
</span>
