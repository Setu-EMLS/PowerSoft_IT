@model IEnumerable<Announcement>
@{
    // Set ViewData["CanDelete"] = true and ViewData["DeleteUrl"] = "/Area/Controller/Delete" to show delete buttons
    var canDelete = ViewData["CanDelete"] as bool? ?? false;
    var deleteUrl = ViewData["DeleteUrl"] as string;
}
@foreach (var a in Model)
{
    <div class="card-lms mb-3">
        <div class="card-lms-body">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                    <h6 class="fw-semibold mb-1">@a.Title</h6>
                    <div class="small text-muted mb-2">
                        <span class="badge @(a.CourseId == null ? "bg-primary" : "bg-light text-dark border") me-1">@(a.Course?.Title ?? "Everyone")</span>
                        @a.CreatedByName · @a.CreatedAt.ToString("dd MMM yyyy, h:mm tt")
                    </div>
                </div>
                @if (canDelete && deleteUrl != null)
                {
                    <form action="@deleteUrl/@a.Id" method="post" class="inline-form" data-confirm="Delete this announcement?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                    </form>
                }
            </div>
            <div class="player-article">@a.Message</div>
        </div>
    </div>
}
@if (!Model.Any())
{
    <div class="card-lms"><div class="empty-state"><i class="fa-solid fa-bullhorn"></i>No announcements yet.</div></div>
}
