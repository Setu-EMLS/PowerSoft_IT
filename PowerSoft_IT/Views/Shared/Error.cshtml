@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["HideCta"] = true;
}
<section class="ps-section">
    <div class="container" style="max-width:640px">
        <div class="ps-card text-center p-5">
            <span class="d-inline-flex align-items-center justify-content-center ic-orange rounded-circle mb-3" style="width:76px;height:76px;font-size:2rem"><i class="bi bi-exclamation-triangle"></i></span>
            <h1 class="h3 mb-2">Something went wrong</h1>
            <p class="text-muted-ps mb-4">An error occurred while processing your request. Please try again, or contact us if it keeps happening.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted-ps">Request ID: <code>@Model.RequestId</code></p>
            }
            <a href="/" class="btn-ps me-2">Back to home</a>
            <a href="/ContactUs" class="btn-ps-outline">Contact support</a>
        </div>
    </div>
</section>
